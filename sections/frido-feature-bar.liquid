<div class="frido-feature-bar color-{{ section.settings.color_scheme }} gradient">
  <div class="frido-page-width frido-feature-bar__row">
    {% for block in section.blocks %}
      {% if block.type == 'item' %}
        <div class="frido-feature-bar__item" {{ block.shopify_attributes }}>
          <div class="frido-feature-bar__icon" aria-hidden="true">
            {% render 'frido-icon-or-image',
              image: block.settings.icon_image,
              icon: block.settings.icon,
              size: 44,
              layout: 'bar'
            %}
          </div>
          <div class="frido-feature-bar__text">
            <strong>{{ block.settings.title | escape }}</strong>
          </div>
        </div>
      {% endif %}
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "Frido — feature bar",
  "tag": "section",
  "class": "section-frido-feature-bar",
  "max_blocks": 2,
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Zero Drop Sole" },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon (if no image)",
          "options": [{ "value": "foot", "label": "Foot" }, { "value": "flex", "label": "Flexible" }],
          "default": "foot"
        },
        {
          "type": "image_picker",
          "id": "icon_image",
          "label": "Icon image",
          "info": "Optional. Replaces the built-in icon."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Frido — feature bar",
      "blocks": [
        { "type": "item", "settings": { "title": "Zero Drop Sole", "icon": "foot" } },
        { "type": "item", "settings": { "title": "Ultra Flexible Material", "icon": "flex" } }
      ]
    }
  ]
}
{% endschema %}
