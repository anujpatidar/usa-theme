{{ 'frido-collection.css' | asset_url | stylesheet_tag }}
<script src="{{ 'frido-collection-redirect.js' | asset_url }}"></script>
<script src="{{ 'frido-collection-card.js' | asset_url }}" defer="defer"></script>

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="frido-collection-page section-{{ section.id }}-padding gradient color-{{ section.settings.color_scheme }}">
  {%- paginate collection.products by section.settings.products_per_page -%}
    {%- liquid
      assign promo_blocks = section.blocks | where: 'type', 'promo'
      assign promo_block = promo_blocks | first
      assign promo_position = section.settings.promo_position | default: 4

      assign collection_sort_key = collection.handle | default: 'collection'
      if collection.all_tags.size > 0
        assign sorted_tags = collection.all_tags | sort_natural | join: '+'
        assign collection_sort_key = collection.handle | append: '+' | append: sorted_tags
      endif

      assign collection_variant_seed = collection.id | split: '/' | last | plus: 0
      for tag in collection.all_tags
        assign collection_variant_seed = collection_variant_seed | times: 31 | plus: tag.size
      endfor
    -%}

    {% render 'frido-facets-bar',
      results: collection,
      section: section,
      enable_filtering: section.settings.enable_filtering,
      enable_sorting: section.settings.enable_sorting,
      paginate: paginate,
      bar_id: 'main-collection-filters',
      wrapper_class: 'frido-collection-page__filters'
    %}

    <div
      class="product-grid-container frido-collection-page__grid"
      id="ProductGridContainer"
    >
      {%- if collection.products.size == 0 -%}
        <div class="frido-page-width frido-collection-page__empty">
          <h2>{{ 'sections.collection_template.empty' | t }}</h2>
          <p>
            {{
              'sections.collection_template.use_fewer_filters_html'
              | t: link: collection.url, class: 'underlined-link link'
            }}
          </p>
        </div>
      {%- else -%}
        <div class="frido-page-width">
          <div class="collection frido-collection-page__products">
            <ul
              id="product-grid"
              data-id="{{ section.id }}"
              data-collection-key="{{ collection_sort_key }}"
              class="frido-collection-page__list"
              style="--frido-cols: {{ section.settings.columns_desktop }}; --frido-cols-m: {{ section.settings.columns_mobile }};"
            >
              {%- for product in collection.products -%}
                {%- if promo_block != blank and forloop.index == promo_position -%}
                  <li class="frido-collection-page__item frido-collection-page__item--promo">
                    {% render 'frido-collection-promo', block: promo_block %}
                  </li>
                {%- endif -%}
                <li class="frido-collection-page__item">
                  {% render 'frido-product-card',
                    card_product: product,
                    show_swatches: true,
                    collection_seed: collection_variant_seed
                  %}
                </li>
              {%- endfor -%}
            </ul>

            {%- if paginate.pages > 1 -%}
              <nav class="frido-collection-page__pagination" aria-label="{{ 'general.pagination.label' | t }}">
                {%- if paginate.previous -%}
                  <a href="{{ paginate.previous.url }}" class="frido-btn frido-btn--outline">← Previous</a>
                {%- endif -%}
                <span class="frido-collection-page__pagination-info">
                  Page {{ paginate.current_page }} of {{ paginate.pages }}
                </span>
                {%- if paginate.next -%}
                  <a href="{{ paginate.next.url }}" class="frido-btn frido-btn--outline">Next →</a>
                {%- endif -%}
              </nav>
            {%- endif -%}
          </div>
        </div>
      {%- endif -%}
    </div>
  {%- endpaginate -%}
</div>

{% schema %}
{
  "name": "Frido — collection grid",
  "class": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "products_per_page",
      "min": 8,
      "max": 36,
      "step": 4,
      "default": 32,
      "label": "Products per page"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 4,
      "label": "Columns on desktop"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" }
      ],
      "default": "2",
      "label": "Columns on mobile"
    },
    {
      "type": "range",
      "id": "promo_position",
      "min": 1,
      "max": 12,
      "step": 1,
      "label": "Promo card position in grid",
      "default": 4,
      "info": "Inserts the promo block at this slot (e.g. 4 = first row, last column on desktop)."
    },
    {
      "type": "checkbox",
      "id": "enable_filtering",
      "default": true,
      "label": "Enable filtering",
      "info": "Configure filters in Settings → Search & Discovery."
    },
    {
      "type": "checkbox",
      "id": "enable_sorting",
      "default": true,
      "label": "Enable sorting"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "promo",
      "name": "Promo card",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "logo_text", "label": "Logo text", "default": "HIKE" },
        { "type": "text", "id": "heading_prefix", "label": "Heading prefix", "default": "Your Path To" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "HEALTHY FREEDOM" },
        {
          "type": "textarea",
          "id": "badges",
          "label": "Trust badges (one per line)",
          "default": "30-DAY MONEY-BACK GUARANTEE\nFREE SHIPPING WORLDWIDE\nHSA/FSA ELIGIBLE\n2,000,000 HAPPY CUSTOMERS"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Frido — collection grid",
      "blocks": [
        {
          "type": "promo",
          "settings": {
            "logo_text": "Frido",
            "heading_prefix": "Your Path To",
            "heading": "HEALTHY FREEDOM"
          }
        }
      ]
    }
  ]
}
{% endschema %}
