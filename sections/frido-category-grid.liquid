<div class="frido-cat-grid color-{{ section.settings.color_scheme }} gradient">
  <div class="frido-page-width">
    {% if section.settings.title != blank %}
      <h2 class="frido-cat-grid__title">{{ section.settings.title | escape }}</h2>
    {% endif %}
    <div class="frido-cat-grid__items">
      {% for block in section.blocks %}
        {% if block.type == 'category' %}
          <a href="{{ block.settings.link | default: '#' }}" class="frido-cat-card" {{ block.shopify_attributes }}>
            <div class="frido-cat-card__media">
              {% if block.settings.image != blank %}
                {%- assign cat_alt = block.settings.title | default: 'Category' | escape -%}
                {{
                  block.settings.image
                  | image_url: width: 800
                  | image_tag:
                    loading: 'lazy',
                    class: 'frido-cat-card__img',
                    widths: '300,400,600,800',
                    sizes: '(min-width: 990px) 22vw, 44vw',
                    alt: cat_alt
                }}
              {% else %}
                {{ 'product-apparel-1' | placeholder_svg_tag: 'frido-cat-card__img frido-cat-card__img--placeholder' }}
              {% endif %}
            </div>
            <div class="frido-cat-card__label">{{ block.settings.title | escape }}</div>
          </a>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Frido — category grid",
  "tag": "section",
  "class": "section-frido-cat-grid",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Explore Your Path to Healthy Freedom"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        { "type": "text", "id": "title", "label": "Label", "default": "Barefoot Shoes" },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Frido — category grid",
      "blocks": [
        { "type": "category", "settings": { "title": "Barefoot Shoes" } },
        { "type": "category", "settings": { "title": "Barefoot Boots" } },
        { "type": "category", "settings": { "title": "Barefoot Hiking Shoes" } },
        { "type": "category", "settings": { "title": "Barefoot Shoes for Kids" } }
      ]
    }
  ]
}
{% endschema %}
