      "id": "sale_subtext",
      "label": "Sale subtext",
      "default": "Verified Lowest Price of the Year. Shop Now!"
    },
    {
      "type": "header",
      "content": "Publisher & hero"
    },
    {
      "type": "text",
      "id": "publisher_label",
      "label": "Publisher label",
      "default": "FRIDO INSIDER"
    },
    {
