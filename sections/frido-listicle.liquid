{{ 'frido-listicle.css' | asset_url | stylesheet_tag }}
<script src="{{ 'frido-listicle.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign product = section.settings.product
  if product != blank
    assign cta_url = product.url
    assign product_price = product.price | money
    assign compare_price = product.compare_at_price | money
    assign product_title = product.title
    if product.featured_image
      assign hero_product_img = product.featured_image | image_url: width: 200
    endif
  else
    assign cta_url = section.settings.cta_url | default: '/products/frido-active-casual-sneakers-mens'
    assign product_price = section.settings.product_price | default: '$99'
    assign compare_price = section.settings.compare_price | default: '$129'
    assign product_title = section.settings.product_name | default: 'Frido Active Casual Sneakers'
    assign hero_product_img = section.settings.compare_product_image
  endif
-%}

<article class="frido-listicle" id="frido-listicle-{{ section.id }}">
  {%- if section.settings.show_sale_bar -%}
    <div class="frido-listicle__bar" data-frido-countdown>
      <div class="frido-listicle__bar-inner">
        <span class="frido-listicle__bar-badge">👟 {{ section.settings.sale_badge | escape }}</span>
        <span>{{ section.settings.sale_text | escape }}</span>
        {%- if section.settings.show_countdown -%}
          <span class="frido-listicle__countdown" aria-label="Sale ends in">
            <span class="frido-listicle__countdown-num" data-countdown-hours>00</span>
            <span class="frido-listicle__countdown-sep">Hrs</span>
            <span class="frido-listicle__countdown-sep">:</span>
            <span class="frido-listicle__countdown-num" data-countdown-mins>00</span>
            <span class="frido-listicle__countdown-sep">Min</span>
            <span class="frido-listicle__countdown-sep">:</span>
            <span class="frido-listicle__countdown-num" data-countdown-secs>00</span>
            <span class="frido-listicle__countdown-sep">Sec</span>
          </span>
        {%- endif -%}
        {%- if section.settings.sale_subtext != blank -%}
          <span class="frido-listicle__bar-sub">{{ section.settings.sale_subtext | escape }}</span>
        {%- endif -%}
      </div>
    </div>
  {%- endif -%}

  {%- if section.settings.publisher_label != blank -%}
    <div class="frido-listicle__nav">
      <div class="frido-listicle__nav-brand">{{ section.settings.publisher_label | escape }}</div>
    </div>
  {%- endif -%}

  <header class="frido-listicle__hero">
    <div class="frido-listicle__wrap">
      {%- if section.settings.headline != blank -%}
        <h1>{{ section.settings.headline }}</h1>
      {%- endif -%}
      {%- if section.settings.intro != blank -%}
        <div class="frido-listicle__intro rte">{{ section.settings.intro }}</div>
      {%- endif -%}
      {%- if section.settings.note != blank -%}
        <div class="frido-listicle__note">{{ section.settings.note | escape }}</div>
      {%- endif -%}

      <div class="frido-listicle__author">
        {%- if section.settings.author_image != blank -%}
          {{
            section.settings.author_image
            | image_url: width: 112
            | image_tag: class: 'frido-listicle__author-img', loading: 'lazy', alt: section.settings.author_name
          }}
        {%- endif -%}
        <div>
          {%- if section.settings.author_name != blank -%}
            <div class="frido-listicle__author-name">{{ section.settings.author_name | escape }}</div>
          {%- endif -%}
          {%- if section.settings.author_role != blank -%}
            <div class="frido-listicle__author-role">{{ section.settings.author_role | escape }}</div>
          {%- endif -%}
        </div>
      </div>
    </div>
  </header>

  <div class="frido-listicle__wrap frido-listicle__wrap--wide">
    {%- if section.settings.show_compare -%}
      <div class="frido-listicle__compare">
        <div class="frido-listicle__compare-grid" role="table">
          <div class="frido-listicle__compare-cell frido-listicle__compare-cell--label frido-listicle__compare-cell--head" role="columnheader"></div>
          <div class="frido-listicle__compare-cell frido-listicle__compare-cell--head frido-listicle__compare-cell--hero" role="columnheader">
            {%- if section.settings.compare_product_image != blank -%}
              {{
                section.settings.compare_product_image
                | image_url: width: 144
                | image_tag: class: 'frido-listicle__compare-product-img', loading: 'lazy', alt: product_title
              }}
            {%- elsif section.settings.compare_product_image_url != blank -%}
              <img src="{{ section.settings.compare_product_image_url }}" alt="{{ product_title | escape }}" class="frido-listicle__compare-product-img" loading="lazy" width="72" height="72">
            {%- elsif hero_product_img != blank -%}
              <img src="{{ hero_product_img }}" alt="{{ product_title | escape }}" class="frido-listicle__compare-product-img" loading="lazy" width="72" height="72">
            {%- endif -%}
            <span>{{ section.settings.compare_col1_title | escape }}</span>
          </div>
          <div class="frido-listicle__compare-cell frido-listicle__compare-cell--head" role="columnheader">{{ section.settings.compare_col2_title | escape }}</div>
          <div class="frido-listicle__compare-cell frido-listicle__compare-cell--head" role="columnheader">{{ section.settings.compare_col3_title | escape }}</div>

          <div class="frido-listicle__compare-cell frido-listicle__compare-cell--label" role="rowheader">{{ section.settings.compare_row_time_label | escape }}</div>
          <div class="frido-listicle__compare-cell frido-listicle__compare-cell--hero" role="cell">{{ section.settings.compare_row_time_col1 | escape }}</div>
          <div class="frido-listicle__compare-cell" role="cell">{{ section.settings.compare_row_time_col2 | escape }}</div>
          <div class="frido-listicle__compare-cell" role="cell">{{ section.settings.compare_row_time_col3 | escape }}</div>

          <div class="frido-listicle__compare-cell frido-listicle__compare-cell--label" role="rowheader">{{ section.settings.compare_row_comfort_label | escape }}</div>
          <div class="frido-listicle__compare-cell frido-listicle__compare-cell--hero" role="cell">{{ section.settings.compare_row_comfort_col1 | escape }}</div>
          <div class="frido-listicle__compare-cell" role="cell">{{ section.settings.compare_row_comfort_col2 | escape }}</div>
          <div class="frido-listicle__compare-cell" role="cell">{{ section.settings.compare_row_comfort_col3 | escape }}</div>

          <div class="frido-listicle__compare-cell frido-listicle__compare-cell--label" role="rowheader">{{ section.settings.compare_row_weight_label | escape }}</div>
          <div class="frido-listicle__compare-cell frido-listicle__compare-cell--hero" role="cell">{{ section.settings.compare_row_weight_col1 | escape }}</div>
          <div class="frido-listicle__compare-cell" role="cell">{{ section.settings.compare_row_weight_col2 | escape }}</div>
          <div class="frido-listicle__compare-cell" role="cell">{{ section.settings.compare_row_weight_col3 | escape }}</div>

          <div class="frido-listicle__compare-cell frido-listicle__compare-cell--label" role="rowheader">{{ section.settings.compare_row_price_label | escape }}</div>
          <div class="frido-listicle__compare-cell frido-listicle__compare-cell--hero" role="cell">
            <span class="frido-listicle__compare-price">{{ product_price }}<small>{{ section.settings.compare_price_note | escape }}</small></span>
          </div>
          <div class="frido-listicle__compare-cell" role="cell">{{ section.settings.compare_row_price_col2 | escape }}</div>
          <div class="frido-listicle__compare-cell" role="cell">{{ section.settings.compare_row_price_col3 | escape }}</div>
        </div>
      </div>
    {%- endif -%}

    {%- if section.settings.tldr != blank -%}
      <p class="frido-listicle__tldr">{{ section.settings.tldr | escape }}</p>
    {%- endif -%}
  </div>

  <div class="frido-listicle__wrap frido-listicle__wrap--wide">
    {%- assign reason_index = 0 -%}
    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when 'reason' -%}
          {%- assign reason_index = reason_index | plus: 1 -%}
          {%- assign reason_even = reason_index | modulo: 2 -%}
          <section class="frido-listicle__reason" {{ block.shopify_attributes }}>
            <div class="frido-listicle__reason-inner{% if reason_even == 0 %} frido-listicle__reason-inner--reverse{% endif %}">
                {%- if block.settings.image != blank -%}
                <div class="frido-listicle__reason-media">
                  {{
                    block.settings.image
                    | image_url: width: 800
                    | image_tag: loading: 'lazy', alt: block.settings.title
                  }}
                </div>
              {%- elsif block.settings.image_url != blank -%}
                <div class="frido-listicle__reason-media">
                  <img src="{{ block.settings.image_url }}" alt="{{ block.settings.title | escape }}" loading="lazy" width="800" height="600">
                </div>
              {%- endif -%}
              <div class="frido-listicle__reason-body">
                {%- if block.settings.title != blank -%}
                  <h2>{{ block.settings.title }}</h2>
                {%- endif -%}
                {%- if block.settings.body != blank -%}
                  <div class="frido-listicle__reason-text rte">{{ block.settings.body }}</div>
                {%- endif -%}
                {%- if block.settings.link_label != blank -%}
                  <a class="frido-listicle__reason-link" href="{{ block.settings.link_url | default: cta_url }}">
                    👉 {{ block.settings.link_label | escape }}
                  </a>
                {%- endif -%}
              </div>
            </div>
          </section>

        {%- when 'cta' -%}
          <div class="frido-listicle__cta" {{ block.shopify_attributes }}>
            {%- if block.settings.eyebrow != blank -%}
              <div class="frido-listicle__cta-eyebrow">{{ block.settings.eyebrow | escape }}</div>
            {%- endif -%}
            {%- if block.settings.heading != blank -%}
              <h3>{{ block.settings.heading | escape }}</h3>
            {%- endif -%}
            {%- if block.settings.subtext != blank -%}
              <p class="frido-listicle__cta-sub">{{ block.settings.subtext | escape }}</p>
            {%- endif -%}
            <a class="frido-listicle__cta-btn" href="{{ block.settings.button_url | default: cta_url }}">
              {{ block.settings.button_label | default: 'TRY THEM RISK-FREE' | escape }}
            </a>
            <div class="frido-listicle__cta-meta">
              {%- if block.settings.urgency != blank -%}
                <strong>{{ block.settings.urgency | escape }}</strong>
              {%- endif -%}
              {%- if block.settings.shipping_note != blank -%}
                <span>| {{ block.settings.shipping_note | escape }}</span>
              {%- endif -%}
            </div>
            {%- if block.settings.guarantee != blank -%}
              <p class="frido-listicle__cta-guarantee">{{ block.settings.guarantee | escape }}</p>
            {%- endif -%}
          </div>
      {%- endcase -%}
    {%- endfor -%}
  </div>

  {%- if section.settings.show_proof -%}
    <footer class="frido-listicle__proof">
      <div class="frido-listicle__proof-label">{{ section.settings.proof_label | escape }}</div>
      <div class="frido-listicle__proof-row">
        {%- if section.settings.proof_avatar != blank -%}
          {{
            section.settings.proof_avatar
            | image_url: width: 80
            | image_tag: class: 'frido-listicle__proof-avatar', loading: 'lazy', alt: section.settings.proof_name
          }}
        {%- endif -%}
        {%- if section.settings.proof_name != blank -%}
          <span class="frido-listicle__proof-name">{{ section.settings.proof_name | escape }}</span>
        {%- endif -%}
        {%- if section.settings.proof_count != blank -%}
          <span class="frido-listicle__proof-count">{{ section.settings.proof_count | escape }}</span>
        {%- endif -%}
      </div>
    </footer>
  {%- endif -%}
</article>

{% schema %}
