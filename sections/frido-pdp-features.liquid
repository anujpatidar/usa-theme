{{ 'frido-product.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign pdp_product = product
  if section.settings.product != blank
    assign pdp_product = section.settings.product
  endif
-%}

{%- if pdp_product != blank -%}
  {%- capture features_markup -%}
    {% render 'frido-pdp-features', product: pdp_product, section: section %}
  {%- endcapture -%}
  {%- assign features_markup = features_markup | strip -%}
  {%- if features_markup != blank -%}
    <div
      class="section-frido-pdp-features color-{{ section.settings.color_scheme }} gradient"
      id="FridoPdpFeatures-{{ section.id }}"
    >
      <div class="frido-page-width">
        {{ features_markup }}
      </div>
    </div>
  {%- elsif request.design_mode -%}
    <div class="frido-page-width" style="padding: 1.5rem; text-align: center; opacity: 0.65; font-size: 0.9rem;">
      <p>PDP features — assign <strong>custom.pdp_features</strong> on this product to show content.</p>
    </div>
  {%- endif -%}
{%- elsif request.design_mode -%}
  <div class="frido-page-width" style="padding: 2rem 1.5rem; text-align: center; opacity: 0.7;">
    <p>Add this section on a product template, or choose a product below.</p>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "PDP features",
  "tag": "section",
  "class": "section-frido-pdp-features-wrap",
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Product",
      "info": "Leave blank on product pages to use the current product. Required on other templates."
    },
    {
      "type": "paragraph",
      "content": "Content only from product metafield custom.pdp_features (PDP Features metaobject). Section is hidden when that metafield is empty."
    },
    {
      "type": "color",
      "id": "features_media_bg",
      "label": "Media background color",
      "default": "#d8dfd0"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    }
  ],
  "presets": [{ "name": "PDP features" }]
}
{% endschema %}
