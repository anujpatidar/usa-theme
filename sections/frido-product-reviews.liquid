{{ 'frido-product-reviews.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign review_product = product
  if section.settings.product != blank
    assign review_product = section.settings.product
  endif

  assign review_count = review_product.metafields.reviews.rating_count.value | default: 0 | plus: 0
  assign ugc_blocks = section.blocks | where: 'type', 'ugc_review'
  assign app_blocks = section.blocks | where: 'type', '@app'
  assign use_judgeme = section.settings.enable_judgeme
  assign show_fallback = false
  if ugc_blocks.size > 0 and use_judgeme == false
    assign show_fallback = true
  endif

  assign has_reviews = false
  if review_count > 0 or show_fallback or app_blocks.size > 0 or use_judgeme
    assign has_reviews = true
  endif

  assign show_section = true
  if section.settings.hide_when_no_reviews and has_reviews == false
    assign show_section = false
  endif
-%}

{%- unless show_section -%}
  {%- comment -%} Hidden when no reviews and Judge.me off. {%- endcomment -%}
{%- else -%}

<section
  id="frido-product-reviews"
  class="frido-pdp-reviews color-{{ section.settings.color_scheme }} gradient{% if use_judgeme %} frido-pdp-reviews--judgeme{% endif %}"
  data-frido-pdp-reviews
  data-section-id="{{ section.id }}"
>
  <div class="frido-pdp-reviews__wrap">
    {%- for block in app_blocks -%}
      <div class="frido-pdp-reviews__app" {{ block.shopify_attributes }}>
        {% render block %}
      </div>
    {%- endfor -%}

    {%- if use_judgeme -%}
      <div class="frido-pdp-reviews__judgeme" data-frido-judgeme-root>
        {% render 'frido-judgeme-embed', product: review_product %}
      </div>
    {%- elsif show_fallback -%}
      <header class="frido-pdp-reviews__header">
        <p class="frido-pdp-reviews__count">{{ section.settings.empty_count_label | default: 'Customer reviews' | escape }}</p>
      </header>
      <div class="frido-pdp-reviews__masonry" data-frido-reviews-fallback>
        {%- for block in ugc_blocks -%}
          {% render 'frido-pdp-ugc-review-card', block: block %}
        {%- endfor -%}
      </div>
    {%- else -%}
      <div class="frido-pdp-reviews__setup">
        <p>
          <strong>Reviews not connected yet.</strong><br>
          Install <a href="https://apps.shopify.com/judgeme" rel="noopener">Judge.me</a>, run <strong>Install widgets</strong> in the app, import reviews, then enable
          <strong>Judge.me widget</strong> in this section.
        </p>
      </div>
    {%- endif -%}
  </div>
</section>

{%- endunless -%}

{% schema %}
{
  "name": "Frido — PDP reviews",
  "tag": "section",
  "class": "section-frido-pdp-reviews",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "product",
      "id": "product",
      "label": "Product (leave empty on product template)"
    },
    {
      "type": "checkbox",
      "id": "enable_judgeme",
      "label": "Show Judge.me review widget",
      "default": true,
      "info": "Uses Judge.me header (stars, count, Write a review, filters). Requires Judge.me app + judgeme_core in theme."
    },
    {
      "type": "checkbox",
      "id": "hide_when_no_reviews",
      "label": "Hide section when Judge.me is off and product has no reviews",
      "default": false,
      "info": "When Judge.me is on, the section always shows so the widget can load."
    },
    {
      "type": "text",
      "id": "empty_count_label",
      "label": "Fallback section title (UGC blocks only)",
      "default": "Customer reviews"
    }
  ],
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "ugc_review",
      "name": "UGC review (fallback)",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Customer photo"
        },
        {
          "type": "text",
          "id": "image_url",
          "label": "Photo URL (if no upload)"
        },
        {
          "type": "text",
          "id": "author",
          "label": "Customer name",
          "default": "Erin B."
        },
        {
          "type": "checkbox",
          "id": "verified",
          "label": "Show verified badge",
          "default": true
        },
        {
          "type": "range",
          "id": "rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "label": "Star rating",
          "default": 5
        },
        {
          "type": "richtext",
          "id": "body",
          "label": "Review text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Frido — PDP reviews"
    }
  ],
  "enabled_on": {
    "templates": ["product"]
  }
}
{% endschema %}
