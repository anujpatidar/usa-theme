{{ 'frido-product.css' | asset_url | stylesheet_tag }}
<script src="{{ 'frido-product.js' | asset_url }}" defer="defer"></script>
{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign compare_at = current_variant.compare_at_price
  assign price = current_variant.price
  assign save_pct = 0
  if compare_at != blank and compare_at > price
    assign save_pct = compare_at | minus: price | times: 100.0 | divided_by: compare_at | round
  endif
  assign form_id = 'frido-product-form-' | append: section.id
  assign benefit_blocks = section.blocks | where: 'type', 'benefit'
  assign bundle_blocks = section.blocks | where: 'type', 'bundle'
  assign ugc_blocks = section.blocks | where: 'type', 'ugc_image'
-%}

<div
  class="frido-pdp color-{{ section.settings.color_scheme }} gradient"
  id="FridoProduct-{{ section.id }}"
  data-section="{{ section.id }}"
  data-product-id="{{ product.id }}"
  data-money-format="{{ shop.money_format | escape }}"
  data-frido-pdp
>
  <script type="application/json" data-frido-product-json>
    {{ product | json }}
  </script>
  <script type="application/json" data-frido-product-media-json>
    {% render 'frido-product-media-json', product: product %}
  </script>

  {%- comment -%} Sticky quick-buy bar (HIKE-style) {%- endcomment -%}
  <div class="frido-pdp-sticky" data-frido-pdp-sticky hidden>
    <div class="frido-page-width frido-pdp-sticky__inner">
      <div class="frido-pdp-sticky__product">
        {%- if current_variant.featured_image -%}
          {{
            current_variant.featured_image
            | image_url: width: 120
            | image_tag: loading: 'lazy', class: 'frido-pdp-sticky__thumb', widths: '60,120', sizes: '48px', alt: ''
          }}
        {%- elsif product.featured_image -%}
          {{
            product.featured_image
            | image_url: width: 120
            | image_tag: loading: 'lazy', class: 'frido-pdp-sticky__thumb', widths: '60,120', sizes: '48px', alt: ''
          }}
        {%- endif -%}
        <div class="frido-pdp-sticky__meta">
          <span class="frido-pdp-sticky__title" data-frido-sticky-title>{{ product.title | escape }}</span>
          <div class="frido-pdp-sticky__prices">
            <span class="frido-pdp-sticky__price" data-frido-sticky-price>{{ price | money }}</span>
            <span class="frido-pdp-sticky__badge" data-frido-sticky-badge{% if save_pct <= 0 %} hidden{% endif %}>
              <span class="frido-pdp-sticky__badge-icon">{% render 'frido-icon-discount' %}</span>
              <span data-frido-sticky-badge-text>{%- if save_pct > 0 -%}Save {{ save_pct }}%{%- endif -%}</span>
            </span>
          </div>
        </div>
      </div>
      <div
        class="frido-pdp-sticky__selects"
        data-frido-sticky-selects
        style="--frido-sticky-cols: {{ product.options.size | at_least: 1 }}"
      >
        {% render 'frido-pdp-sticky-selects', product: product, section: section %}
      </div>
      <button type="button" class="frido-pdp-sticky__atc" data-frido-sticky-atc>
        {{ section.settings.sticky_atc_label | default: 'Add to Cart' | escape }}
      </button>
    </div>
  </div>

  <div class="frido-page-width frido-pdp__layout">
    <div class="frido-pdp__top">
      <div class="frido-pdp__head-mobile">
        {% render 'frido-pdp-social-proof', section: section %}
        <div class="frido-pdp__title-row">
          <h1 class="frido-pdp__title">{{ product.title | escape }}</h1>
          {% render 'frido-pdp-price-row', price: price, compare_at: compare_at, save_pct: save_pct %}
        </div>
        {%- if section.settings.rating_line != blank -%}
          <p class="frido-pdp__rating">
            {% render 'frido-stars', rating: 5 %}
            {%- if section.settings.reviews_url != blank -%}
              <a href="{{ section.settings.reviews_url }}">{{ section.settings.rating_line | escape }}</a>
            {%- else -%}
              <span>{{ section.settings.rating_line | escape }}</span>
            {%- endif -%}
          </p>
        {%- endif -%}
      </div>

      <div class="frido-pdp__gallery-col">
        {% render 'frido-pdp-gallery', product: product, section_id: section.id %}
        <div class="frido-pdp__badges-mobile">
          {% render 'frido-pdp-selling-fast', section: section %}
          {%- for block in benefit_blocks -%}
            <p class="frido-pdp__benefit" {{ block.shopify_attributes }}>
              {% render 'frido-pdp-benefit-icon', icon: block.settings.icon, image: block.settings.icon_image %}
              <span class="frido-pdp__benefit-text">{{ block.settings.text | escape }}</span>
            </p>
          {%- endfor -%}
        </div>
      </div>

      <div class="frido-pdp__buy-col">
        <div class="frido-pdp__head-desktop">
          {% render 'frido-pdp-social-proof', section: section %}
          <div class="frido-pdp__title-row">
            <h1 class="frido-pdp__title">{{ product.title | escape }}</h1>
            {% render 'frido-pdp-price-row', price: price, compare_at: compare_at, save_pct: save_pct %}
          </div>
          {%- if section.settings.rating_line != blank -%}
            <p class="frido-pdp__rating">
              {% render 'frido-stars', rating: 5 %}
              {%- if section.settings.reviews_url != blank -%}
                <a href="{{ section.settings.reviews_url }}">{{ section.settings.rating_line | escape }}</a>
              {%- else -%}
                <span>{{ section.settings.rating_line | escape }}</span>
              {%- endif -%}
            </p>
          {%- endif -%}
          {% render 'frido-pdp-selling-fast', section: section %}
          <div class="frido-pdp__benefits-desktop">
            {%- for block in benefit_blocks -%}
              <p class="frido-pdp__benefit" {{ block.shopify_attributes }}>
                {% render 'frido-pdp-benefit-icon', icon: block.settings.icon, image: block.settings.icon_image %}
                <span class="frido-pdp__benefit-text">{{ block.settings.text | escape }}</span>
              </p>
            {%- endfor -%}
          </div>
        </div>

        {%- form 'product', product, id: form_id, class: 'frido-pdp-form', data-frido-product-form: '' -%}
          <input type="hidden" name="id" value="{{ current_variant.id }}" data-frido-variant-id>
          <input type="hidden" name="quantity" value="1" data-frido-quantity>

          {% render 'frido-pdp-variants', product: product, section: section %}

          <div class="frido-pdp__find-size-wrap">
            {% render 'frido-find-size-button', color_scheme: section.settings.color_scheme %}
          </div>

          {% render 'frido-pdp-bundle-picker', product: product, section: section, bundle_blocks: bundle_blocks %}

          <button type="submit" class="frido-pdp-atc" data-frido-atc{% unless current_variant.available %} disabled{% endunless %}>
            <span class="frido-pdp-atc__label">{{ section.settings.atc_label | default: 'ADD TO CART' | escape }}</span>
            <span class="frido-pdp-atc__prices">
              {%- if compare_at > price -%}
                <span class="frido-pdp-atc__compare" data-frido-atc-compare>{{ compare_at | money }}</span>
              {%- endif -%}
              <span class="frido-pdp-atc__price" data-frido-atc-price>{{ price | money }}</span>
            </span>
            <span class="frido-pdp-atc__arrow" aria-hidden="true">→</span>
          </button>

         
        {%- endform -%}

        {% render 'frido-pdp-trust-bar', section: section %}

        {% render 'frido-pdp-ugc', product: product, section: section, ugc_blocks: ugc_blocks %}
      </div>
    </div>

  </div>
</div>

{% render 'frido-size-chart-drawer', section: section, product: product %}

{% schema %}
{
  "name": "Frido product",
  "tag": "section",
  "class": "section-frido-product",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Social proof"
    },
    {
      "type": "image_picker",
      "id": "social_avatar_1",
      "label": "Avatar 1 (left)"
    },
    {
      "type": "image_picker",
      "id": "social_avatar_2",
      "label": "Avatar 2 (center)"
    },
    {
      "type": "image_picker",
      "id": "social_avatar_3",
      "label": "Avatar 3 (right)"
    },
    {
      "type": "text",
      "id": "social_proof_lead",
      "label": "Social proof — text before count",
      "default": "Purchased more than "
    },
    {
      "type": "text",
      "id": "social_proof_stat",
      "label": "Social proof — count (bold)",
      "default": "2,437,825+"
    },
    {
      "type": "text",
      "id": "social_proof_tail",
      "label": "Social proof — text after count",
      "default": " times."
    },
    {
      "type": "text",
      "id": "social_proof",
      "label": "Social proof (legacy single line)",
      "info": "Used only if count field above is empty. Prefer the three text fields.",
      "default": "Purchased more than 2,437,825+ times."
    },
    {
      "type": "text",
      "id": "rating_line",
      "label": "Rating line",
      "default": "Excellent 4.9 | 7,295+ Reviews"
    },
    { "type": "url", "id": "reviews_url", "label": "Reviews link" },
    {
      "type": "text",
      "id": "selling_fast",
      "label": "Selling fast — pill label",
      "default": "Selling Out Fast"
    },
    {
      "type": "text",
      "id": "selling_fast_body_lead",
      "label": "Selling fast — detail (before bold)",
      "default": "This product is in high demand. Based on the sales volume in the past 3 hours, "
    },
    {
      "type": "text",
      "id": "selling_fast_body_bold",
      "label": "Selling fast — detail (bold)",
      "default": "this product is likely to sell out today."
    },
    {
      "type": "header",
      "content": "Gender toggle (Option B — linked products)"
    },
    {
      "type": "paragraph",
      "content": "MEN / WOMEN switches between separate products using product metafields. On each product set custom.mens_product and custom.womens_product (Product reference). See scripts/GENDER-PAIR-SETUP.md in the theme repo for Admin setup and the link-gender-products.mjs script."
    },
    {
      "type": "header",
      "content": "Size & fit chart"
    },
    {
      "type": "checkbox",
      "id": "size_chart_enable",
      "label": "Enable size chart drawer",
      "default": true
    },
    {
      "type": "text",
      "id": "size_chart_title",
      "label": "Drawer title",
      "default": "Size & Fit Chart"
    },
    {
      "type": "text",
      "id": "size_chart_rec_prefix",
      "label": "Recommended size label",
      "default": "Recommended Size:"
    },
    {
      "type": "richtext",
      "id": "size_chart_recommendations",
      "label": "Sizing recommendations (leave blank for default copy)"
    },
    {
      "type": "text",
      "id": "size_chart_product_title",
      "label": "Chart product title",
      "info": "Defaults to product title when blank."
    },
    {
      "type": "text",
      "id": "size_chart_subtitle",
      "label": "Chart subtitle",
      "default": "Men's Size Chart",
      "info": "Shown in italics under the product title, e.g. Men's Size Chart"
    },
    {
      "type": "html",
      "id": "size_chart_table",
      "label": "Size chart table HTML",
      "info": "Paste a full table. Leave blank to use the default men's shoe chart."
    },
    {
      "type": "text",
      "id": "bundle_heading",
      "label": "Bundle promo line",
      "default": "Bundle promotion is valid till 11:59 PM"
    },
    {
      "type": "text",
      "id": "bundle_choose_heading",
      "label": "Configurator heading",
      "default": "Choose your colors"
    },
    {
      "type": "text",
      "id": "bundle_add_pair_label",
      "label": "Add another pair — button",
      "default": "+ Add Another Pair"
    },
    {
      "type": "text",
      "id": "bundle_add_pair_subtext",
      "label": "Add another pair — subtext",
      "default": "Save more on your entire order"
    },
    {
      "type": "range",
      "id": "bundle_max_pairs",
      "min": 2,
      "max": 4,
      "step": 1,
      "label": "Maximum pairs in configurator",
      "default": 3,
      "info": "Capped at 3 pairs in the storefront."
    },
    {
      "type": "text",
      "id": "atc_label",
      "label": "Add to cart label",
      "default": "ADD TO CART"
    },
    {
      "type": "text",
      "id": "sticky_atc_label",
      "label": "Sticky bar ATC label",
      "default": "Add to Cart"
    },
    {
      "type": "text",
      "id": "hsa_text",
      "label": "HSA / FSA line",
      "default": "HSA/FSA eligible · Save an average of 30%"
    },
    { "type": "url", "id": "hsa_link", "label": "HSA learn more link" },
    { "type": "text", "id": "hsa_learn_label", "label": "HSA link label", "default": "Learn more" },
    {
      "type": "text",
      "id": "trust_ship_title",
      "label": "Trust — ship title",
      "default": "In Stock Items Ship By"
    },
    {
      "type": "text",
      "id": "trust_ship_date",
      "label": "Trust — ship date",
      "default": "FRI, MAY 22"
    },
    {
      "type": "text",
      "id": "trust_guarantee_title",
      "label": "Trust — guarantee title",
      "default": "30-Day Guarantee"
    },
    {
      "type": "text",
      "id": "trust_guarantee_sub",
      "label": "Trust — guarantee sub",
      "default": "Try Risk-Free For 30 Days"
    },
    {
      "type": "text",
      "id": "trust_shipping_title",
      "label": "Trust — free shipping title",
      "default": "Free Shipping"
    },
    {
      "type": "text",
      "id": "trust_shipping_sub",
      "label": "Trust — free shipping sub",
      "default": "TO UNITED STATES"
    },
    {
      "type": "header",
      "content": "UGC gallery"
    },
    {
      "type": "paragraph",
      "content": "Add images per product in Shopify admin → Product → Metafields: namespace custom, key ugc_images (type: List of files). Section blocks below are used only when that metafield is empty."
    },
    {
      "type": "text",
      "id": "ugc_heading",
      "label": "UGC heading",
      "default": "2 million customers love our shoes!"
    },
    {
      "type": "paragraph",
      "content": "Story, comfort, features, and product recommendations are separate theme sections. Add them to this template in the order you want (see default product template)."
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit line",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Theme icon",
          "options": [
            { "value": "check", "label": "Checkmark" },
            { "value": "truck", "label": "Truck" },
            { "value": "success", "label": "Success" },
            { "value": "tick", "label": "Tick" },
            { "value": "star", "label": "Star" },
            { "value": "heart", "label": "Heart" },
            { "value": "lightning", "label": "Lightning" },
            { "value": "return", "label": "Return" },
            { "value": "padlock", "label": "Padlock" },
            { "value": "box", "label": "Box" },
            { "value": "price-tag", "label": "Price tag" },
            { "value": "map-pin", "label": "Map pin" },
            { "value": "stopwatch", "label": "Stopwatch" },
            { "value": "shoe", "label": "Shoe" },
            { "value": "discount", "label": "Discount" }
          ],
          "default": "check"
        },
        {
          "type": "image_picker",
          "id": "icon_image",
          "label": "Custom icon (optional)",
          "info": "Overrides theme SVG when set."
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Relieves pressure on feet and joints"
        }
      ]
    },
    {
      "type": "bundle",
      "name": "Bundle option",
      "settings": [
        {
          "type": "text",
          "id": "badge",
          "label": "Badge text",
          "default": "MOST POPULAR"
        },
        {
          "type": "select",
          "id": "badge_style",
          "label": "Badge style",
          "options": [
            { "value": "green", "label": "Green" },
            { "value": "gold", "label": "Gold" }
          ],
          "default": "green"
        },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "title", "label": "Title", "default": "2 Pairs" },
        { "type": "range", "id": "quantity", "min": 1, "max": 6, "step": 1, "label": "Pair count (rows shown)", "default": 2 },
        {
          "type": "text",
          "id": "discount_code",
          "label": "Discount code",
          "info": "Shopify discount code applied after add to cart (e.g. BUNDLE2, BUNDLE3). Create matching automatic discounts in Shopify admin."
        },
        {
          "type": "range",
          "id": "discount_percent",
          "min": 0,
          "max": 80,
          "step": 1,
          "unit": "%",
          "label": "Bundle discount (%)",
          "info": "Applied to the sum of pair prices on the card and Add to Cart. Must match your Shopify discount.",
          "default": 0
        },
        {
          "type": "text",
          "id": "price_text",
          "label": "Price override (optional)",
          "info": "Leave blank to calculate from the selected variant."
        },
        {
          "type": "text",
          "id": "compare_text",
          "label": "Compare override (optional)",
          "info": "Leave blank to show per-pair compare price from the variant."
        },
        {
          "type": "text",
          "id": "save_label",
          "label": "Save badge override (optional)",
          "info": "Leave blank to use “Save X%” from bundle discount % above."
        }
      ]
    },
    {
      "type": "ugc_image",
      "name": "UGC image (fallback)",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        {
          "type": "product",
          "id": "product",
          "label": "Only on this product",
          "info": "Leave empty to show on every product that has no UGC metafield."
        }
      ]
    }
  ],
  "presets": [{ "name": "Frido product" }]
}
{% endschema %}
