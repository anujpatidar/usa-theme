{{ 'frido-product.css' | asset_url | stylesheet_tag }}
<script src="{{ 'frido-product.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign compare_at = current_variant.compare_at_price
  assign price = current_variant.price
  assign save_pct = 0
  if compare_at != blank and compare_at > price
    assign save_pct = compare_at | minus: price | times: 100.0 | divided_by: compare_at | round
  endif
  assign form_id = 'frido-product-form-' | append: section.id
  assign benefit_blocks = section.blocks | where: 'type', 'benefit'
  assign bundle_blocks = section.blocks | where: 'type', 'bundle'
  assign accordion_blocks = section.blocks | where: 'type', 'accordion'
  assign ugc_blocks = section.blocks | where: 'type', 'ugc_image'
-%}

<div
  class="frido-pdp color-{{ section.settings.color_scheme }} gradient"
  id="FridoProduct-{{ section.id }}"
  data-section="{{ section.id }}"
  data-product-id="{{ product.id }}"
  data-frido-pdp
>
  <script type="application/json" data-frido-product-json>
    {{ product | json }}
  </script>
  <script type="application/json" data-frido-product-media-json>
    {% render 'frido-product-media-json', product: product %}
  </script>

  {%- comment -%} Sticky quick-buy bar {%- endcomment -%}
  <div class="frido-pdp-sticky" data-frido-pdp-sticky>
    <div class="frido-page-width frido-pdp-sticky__inner">
      <div class="frido-pdp-sticky__product">
        {%- if current_variant.featured_image -%}
          {{
            current_variant.featured_image
            | image_url: width: 120
            | image_tag: loading: 'lazy', class: 'frido-pdp-sticky__thumb', widths: '60,120', sizes: '48px', alt: ''
          }}
        {%- elsif product.featured_image -%}
          {{
            product.featured_image
            | image_url: width: 120
            | image_tag: loading: 'lazy', class: 'frido-pdp-sticky__thumb', widths: '60,120', sizes: '48px', alt: ''
          }}
        {%- endif -%}
        <div class="frido-pdp-sticky__meta">
          <span class="frido-pdp-sticky__title" data-frido-sticky-title>{{ product.title | escape }}</span>
          <span class="frido-pdp-sticky__prices">
            <span class="frido-pdp-sticky__price" data-frido-sticky-price>{{ price | money }}</span>
            {%- if save_pct > 0 -%}
              <span class="frido-pdp-sticky__badge" data-frido-sticky-badge>Save {{ save_pct }}%</span>
            {%- endif -%}
          </span>
        </div>
      </div>
      <div class="frido-pdp-sticky__selects" data-frido-sticky-selects aria-hidden="true"></div>
      <button type="button" class="frido-pdp-sticky__atc" data-frido-sticky-atc>
        {{ section.settings.sticky_atc_label | default: 'Add to Cart' | escape }}
      </button>
    </div>
  </div>

  <div class="frido-page-width frido-pdp__layout">
    <div class="frido-pdp__top">
      <div class="frido-pdp__head-mobile">
        {% render 'frido-pdp-social-proof', section: section %}
        <div class="frido-pdp__title-row">
          <h1 class="frido-pdp__title">{{ product.title | escape }}</h1>
          <div class="frido-pdp__price-row">
            <span class="frido-pdp__price" data-frido-price>{{ price | money }}</span>
            {%- if compare_at > price -%}
              <span class="frido-pdp__compare" data-frido-compare>{{ compare_at | money }}</span>
            {%- endif -%}
            {%- if save_pct > 0 -%}
              <span class="frido-pdp__save-badge" data-frido-save-badge>Save {{ save_pct }}%</span>
            {%- endif -%}
          </div>
        </div>
        {%- if section.settings.rating_line != blank -%}
          <p class="frido-pdp__rating">
            {% render 'frido-stars', rating: 5 %}
            {%- if section.settings.reviews_url != blank -%}
              <a href="{{ section.settings.reviews_url }}">{{ section.settings.rating_line | escape }}</a>
            {%- else -%}
              <span>{{ section.settings.rating_line | escape }}</span>
            {%- endif -%}
          </p>
        {%- endif -%}
      </div>

      <div class="frido-pdp__gallery-col">
        {% render 'frido-pdp-gallery', product: product, section_id: section.id %}
        <div class="frido-pdp__badges-mobile">
          {%- if section.settings.selling_fast != blank -%}
            <button type="button" class="frido-pdp__selling-fast">{{ section.settings.selling_fast | escape }}</button>
          {%- endif -%}
          {%- for block in benefit_blocks -%}
            <p class="frido-pdp__benefit" {{ block.shopify_attributes }}>
              <span class="frido-pdp__benefit-icon frido-pdp__benefit-icon--{{ block.settings.icon }}" aria-hidden="true"></span>
              {{ block.settings.text | escape }}
            </p>
          {%- endfor -%}
        </div>
      </div>

      <div class="frido-pdp__buy-col">
        <div class="frido-pdp__head-desktop">
          {% render 'frido-pdp-social-proof', section: section %}
          <div class="frido-pdp__title-row">
            <h1 class="frido-pdp__title">{{ product.title | escape }}</h1>
            <div class="frido-pdp__price-row">
              <span class="frido-pdp__price" data-frido-price>{{ price | money }}</span>
              {%- if compare_at > price -%}
                <span class="frido-pdp__compare" data-frido-compare>{{ compare_at | money }}</span>
              {%- endif -%}
              {%- if save_pct > 0 -%}
                <span class="frido-pdp__save-badge" data-frido-save-badge>Save {{ save_pct }}%</span>
              {%- endif -%}
            </div>
          </div>
          {%- if section.settings.rating_line != blank -%}
            <p class="frido-pdp__rating">
              {% render 'frido-stars', rating: 5 %}
              {%- if section.settings.reviews_url != blank -%}
                <a href="{{ section.settings.reviews_url }}">{{ section.settings.rating_line | escape }}</a>
              {%- else -%}
                <span>{{ section.settings.rating_line | escape }}</span>
              {%- endif -%}
            </p>
          {%- endif -%}
          {%- if section.settings.selling_fast != blank -%}
            <button type="button" class="frido-pdp__selling-fast">{{ section.settings.selling_fast | escape }}</button>
          {%- endif -%}
          <div class="frido-pdp__benefits-desktop">
            {%- for block in benefit_blocks -%}
              <p class="frido-pdp__benefit" {{ block.shopify_attributes }}>
                <span class="frido-pdp__benefit-icon frido-pdp__benefit-icon--{{ block.settings.icon }}" aria-hidden="true"></span>
                {{ block.settings.text | escape }}
              </p>
            {%- endfor -%}
          </div>
        </div>

        {%- form 'product', product, id: form_id, class: 'frido-pdp-form', data-frido-product-form: '' -%}
          <input type="hidden" name="id" value="{{ current_variant.id }}" data-frido-variant-id>
          <input type="hidden" name="quantity" value="1" data-frido-quantity>

          {% render 'frido-pdp-variants', product: product, section: section %}

          {%- if section.settings.find_size_label != blank -%}
            <a href="{{ section.settings.find_size_url | default: section.settings.size_chart_url | default: '#' }}" class="frido-pdp__find-size">
              {{ section.settings.find_size_label | escape }}
            </a>
          {%- endif -%}

          {%- if bundle_blocks.size > 0 -%}
            <div class="frido-pdp-bundles">
              {%- if section.settings.bundle_heading != blank -%}
                <p class="frido-pdp-bundles__heading">{{ section.settings.bundle_heading | escape }}</p>
              {%- endif -%}
              <div class="frido-pdp-bundles__grid">
                {%- for block in bundle_blocks -%}
                  <button
                    type="button"
                    class="frido-pdp-bundle{% if forloop.first %} is-active{% endif %}"
                    data-frido-bundle
                    data-quantity="{{ block.settings.quantity | default: 1 }}"
                    {{ block.shopify_attributes }}
                  >
                    {%- if block.settings.badge != blank -%}
                      <span class="frido-pdp-bundle__badge frido-pdp-bundle__badge--{{ block.settings.badge_style }}">{{ block.settings.badge | escape }}</span>
                    {%- endif -%}
                    {%- if block.settings.image != blank -%}
                      {{
                        block.settings.image
                        | image_url: width: 120
                        | image_tag:
                          loading: 'lazy',
                          class: 'frido-pdp-bundle__img',
                          widths: '80,120',
                          sizes: '64px',
                          alt: '',
                          data-frido-bundle-img: ''
                      }}
                    {%- elsif current_variant.featured_image -%}
                      {{
                        current_variant.featured_image
                        | image_url: width: 120
                        | image_tag:
                          loading: 'lazy',
                          class: 'frido-pdp-bundle__img',
                          widths: '80,120',
                          sizes: '64px',
                          alt: '',
                          data-frido-bundle-img: ''
                      }}
                    {%- elsif product.featured_image -%}
                      {{
                        product.featured_image
                        | image_url: width: 120
                        | image_tag:
                          loading: 'lazy',
                          class: 'frido-pdp-bundle__img',
                          widths: '80,120',
                          sizes: '64px',
                          alt: '',
                          data-frido-bundle-img: ''
                      }}
                    {%- endif -%}
                    <span class="frido-pdp-bundle__title">{{ block.settings.title | escape }}</span>
                    <span class="frido-pdp-bundle__price">{{ block.settings.price_text | escape }}</span>
                    {%- if block.settings.compare_text != blank -%}
                      <span class="frido-pdp-bundle__compare">{{ block.settings.compare_text | escape }}</span>
                    {%- endif -%}
                    {%- if block.settings.save_label != blank -%}
                      <span class="frido-pdp-bundle__save">{{ block.settings.save_label | escape }}</span>
                    {%- endif -%}
                  </button>
                {%- endfor -%}
              </div>
            </div>
          {%- endif -%}

          <button type="submit" class="frido-pdp-atc" data-frido-atc{% unless current_variant.available %} disabled{% endunless %}>
            <span class="frido-pdp-atc__label">{{ section.settings.atc_label | default: 'ADD TO CART' | escape }}</span>
            <span class="frido-pdp-atc__prices">
              {%- if compare_at > price -%}
                <span class="frido-pdp-atc__compare" data-frido-atc-compare>{{ compare_at | money }}</span>
              {%- endif -%}
              <span class="frido-pdp-atc__price" data-frido-atc-price>{{ price | money }}</span>
            </span>
            <span class="frido-pdp-atc__arrow" aria-hidden="true">→</span>
          </button>

          {%- if section.settings.hsa_text != blank -%}
            <p class="frido-pdp__hsa">
              {{ section.settings.hsa_text | escape }}
              {%- if section.settings.hsa_link != blank -%}
                <a href="{{ section.settings.hsa_link }}">{{ section.settings.hsa_learn_label | default: 'Learn more' | escape }}</a>
              {%- endif -%}
            </p>
          {%- endif -%}
        {%- endform -%}

        <div class="frido-pdp-trust">
          <div class="frido-pdp-trust__item">
            <span class="frido-pdp-trust__icon frido-pdp-trust__icon--ship" aria-hidden="true"></span>
            <div>
              <p class="frido-pdp-trust__title">{{ section.settings.trust_ship_title | default: 'In Stock Items Ship By' | escape }}</p>
              <p class="frido-pdp-trust__highlight">{{ section.settings.trust_ship_date | default: 'FRI, MAY 22' | escape }}</p>
            </div>
          </div>
          <div class="frido-pdp-trust__item">
            <span class="frido-pdp-trust__icon frido-pdp-trust__icon--guarantee" aria-hidden="true"></span>
            <div>
              <p class="frido-pdp-trust__title"><strong>{{ section.settings.trust_guarantee_title | default: '30-Day Guarantee' | escape }}</strong></p>
              <p class="frido-pdp-trust__sub">{{ section.settings.trust_guarantee_sub | default: 'Try Risk-Free For 30 Days' | escape }}</p>
            </div>
          </div>
          <div class="frido-pdp-trust__item">
            <span class="frido-pdp-trust__icon frido-pdp-trust__icon--flag" aria-hidden="true"></span>
            <div>
              <p class="frido-pdp-trust__title"><strong>{{ section.settings.trust_shipping_title | default: 'Free Shipping' | escape }}</strong></p>
              <p class="frido-pdp-trust__sub frido-pdp-trust__sub--link">{{ section.settings.trust_shipping_sub | default: 'TO UNITED STATES' | escape }}</p>
            </div>
          </div>
        </div>

        {%- if section.settings.ugc_heading != blank -%}
          <div class="frido-pdp-ugc">
            <h2 class="frido-pdp-ugc__heading">{{ section.settings.ugc_heading | escape }}</h2>
            {%- if ugc_blocks.size > 0 -%}
              <div class="frido-pdp-ugc__row">
                {%- for block in ugc_blocks -%}
                  <div class="frido-pdp-ugc__item" {{ block.shopify_attributes }}>
                    {%- if block.settings.image != blank -%}
                      {{ block.settings.image | image_url: width: 400 | image_tag: loading: 'lazy', widths: '200,300,400', sizes: '120px', alt: '' }}
                    {%- endif -%}
                  </div>
                {%- endfor -%}
              </div>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    </div>

    {%- if section.settings.story_heading != blank or section.settings.story_image != blank -%}
      <section class="frido-pdp-story">
        <div class="frido-pdp-story__text">
          {%- if section.settings.story_heading != blank -%}
            <h2>{{ section.settings.story_heading | escape }}</h2>
          {%- endif -%}
          {%- if section.settings.story_body != blank -%}
            <div class="frido-pdp-story__body rte">{{ section.settings.story_body }}</div>
          {%- endif -%}
        </div>
        {%- if section.settings.story_image != blank -%}
          <div class="frido-pdp-story__media">
            {{
              section.settings.story_image
              | image_url: width: 900
              | image_tag: loading: 'lazy', widths: '400,600,900', sizes: '(min-width: 990px) 45vw, 100vw', alt: section.settings.story_heading
            }}
          </div>
        {%- endif -%}
      </section>
    {%- endif -%}

    {%- if accordion_blocks.size > 0 -%}
      <section class="frido-pdp-features">
        <div class="frido-pdp-features__media">
          {%- if section.settings.features_image != blank -%}
            {{
              section.settings.features_image
              | image_url: width: 800
              | image_tag: loading: 'lazy', widths: '400,600,800', sizes: '(min-width: 990px) 45vw, 100vw', alt: section.settings.features_heading
            }}
          {%- elsif product.featured_image -%}
            {{ product.featured_image | image_url: width: 800 | image_tag: loading: 'lazy', class: 'frido-pdp-features__img', widths: '400,600,800', sizes: '50vw', alt: '' }}
          {%- endif -%}
        </div>
        <div class="frido-pdp-features__content">
          {%- if section.settings.features_heading != blank -%}
            <h2>{{ section.settings.features_heading | escape }}</h2>
          {%- endif -%}
          <div class="frido-pdp-accordion" data-frido-accordion>
            {%- for block in accordion_blocks -%}
              <details class="frido-pdp-accordion__item" {{ block.shopify_attributes }}{% if forloop.first %} open{% endif %}>
                <summary>
                  <span class="frido-pdp-accordion__icon frido-pdp-accordion__icon--{{ block.settings.icon }}" aria-hidden="true"></span>
                  <span>{{ block.settings.title | escape }}</span>
                  <span class="frido-pdp-accordion__plus" aria-hidden="true"></span>
                </summary>
                <div class="frido-pdp-accordion__body rte">{{ block.settings.content }}</div>
              </details>
            {%- endfor -%}
          </div>
        </div>
      </section>
    {%- endif -%}

  </div>
</div>

{% schema %}
{
  "name": "Frido product",
  "tag": "section",
  "class": "section-frido-product",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Social proof"
    },
    {
      "type": "image_picker",
      "id": "social_avatar_1",
      "label": "Avatar 1 (left)"
    },
    {
      "type": "image_picker",
      "id": "social_avatar_2",
      "label": "Avatar 2 (center)"
    },
    {
      "type": "image_picker",
      "id": "social_avatar_3",
      "label": "Avatar 3 (right)"
    },
    {
      "type": "text",
      "id": "social_proof_lead",
      "label": "Social proof — text before count",
      "default": "Purchased more than "
    },
    {
      "type": "text",
      "id": "social_proof_stat",
      "label": "Social proof — count (bold)",
      "default": "2,437,825+"
    },
    {
      "type": "text",
      "id": "social_proof_tail",
      "label": "Social proof — text after count",
      "default": " times."
    },
    {
      "type": "text",
      "id": "social_proof",
      "label": "Social proof (legacy single line)",
      "info": "Used only if count field above is empty. Prefer the three text fields.",
      "default": "Purchased more than 2,437,825+ times."
    },
    {
      "type": "text",
      "id": "rating_line",
      "label": "Rating line",
      "default": "Excellent 4.9 | 7,295+ Reviews"
    },
    { "type": "url", "id": "reviews_url", "label": "Reviews link" },
    {
      "type": "text",
      "id": "selling_fast",
      "label": "Urgency badge",
      "default": "Selling Out Fast"
    },
    {
      "type": "text",
      "id": "find_size_label",
      "label": "Find size button",
      "default": "Find my Perfect Size"
    },
    { "type": "url", "id": "find_size_url", "label": "Find size link" },
    { "type": "url", "id": "size_chart_url", "label": "Size chart link" },
    {
      "type": "text",
      "id": "bundle_heading",
      "label": "Bundle promo line",
      "default": "Bundle promotion is valid till 11:59 PM"
    },
    {
      "type": "text",
      "id": "atc_label",
      "label": "Add to cart label",
      "default": "ADD TO CART"
    },
    {
      "type": "text",
      "id": "sticky_atc_label",
      "label": "Sticky bar ATC label",
      "default": "Add to Cart"
    },
    {
      "type": "text",
      "id": "hsa_text",
      "label": "HSA / FSA line",
      "default": "HSA/FSA eligible · Save an average of 30%"
    },
    { "type": "url", "id": "hsa_link", "label": "HSA learn more link" },
    { "type": "text", "id": "hsa_learn_label", "label": "HSA link label", "default": "Learn more" },
    {
      "type": "text",
      "id": "trust_ship_title",
      "label": "Trust — ship title",
      "default": "In Stock Items Ship By"
    },
    {
      "type": "text",
      "id": "trust_ship_date",
      "label": "Trust — ship date",
      "default": "FRI, MAY 22"
    },
    {
      "type": "text",
      "id": "trust_guarantee_title",
      "label": "Trust — guarantee title",
      "default": "30-Day Guarantee"
    },
    {
      "type": "text",
      "id": "trust_guarantee_sub",
      "label": "Trust — guarantee sub",
      "default": "Try Risk-Free For 30 Days"
    },
    {
      "type": "text",
      "id": "trust_shipping_title",
      "label": "Trust — free shipping title",
      "default": "Free Shipping"
    },
    {
      "type": "text",
      "id": "trust_shipping_sub",
      "label": "Trust — free shipping sub",
      "default": "TO UNITED STATES"
    },
    {
      "type": "text",
      "id": "ugc_heading",
      "label": "UGC heading",
      "default": "2 million customers love our shoes!"
    },
    {
      "type": "text",
      "id": "story_heading",
      "label": "Story heading",
      "default": "Discover Natural Freedom of Movement"
    },
    {
      "type": "richtext",
      "id": "story_body",
      "label": "Story body",
      "default": "<p>Your feet weren't designed for stiff, narrow shoes.</p><p><strong>HF Flow</strong> restores your natural gait, improve posture, and keep you comfortable from city walks to all-day wear.</p><p><strong>Why thousands switch to barefoot:</strong></p><ul><li>Zero-drop sole for natural posture</li><li>Extra-roomy toe box to reduce foot pain</li><li>Lightweight, flexible design that moves with you</li></ul><p>Walk naturally. Feel stronger. Move freely.</p>"
    },
    { "type": "image_picker", "id": "story_image", "label": "Story image" },
    {
      "type": "text",
      "id": "features_heading",
      "label": "Features accordion heading",
      "default": "Why HF Flow works?"
    },
    { "type": "image_picker", "id": "features_image", "label": "Features section image" }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit line",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "check", "label": "Check" },
            { "value": "truck", "label": "Truck" }
          ],
          "default": "check"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Relieves pressure on feet and joints"
        }
      ]
    },
    {
      "type": "bundle",
      "name": "Bundle option",
      "settings": [
        {
          "type": "text",
          "id": "badge",
          "label": "Badge text",
          "default": "MOST POPULAR"
        },
        {
          "type": "select",
          "id": "badge_style",
          "label": "Badge style",
          "options": [
            { "value": "green", "label": "Green" },
            { "value": "gold", "label": "Gold" }
          ],
          "default": "green"
        },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "title", "label": "Title", "default": "2 Pairs" },
        { "type": "range", "id": "quantity", "min": 1, "max": 6, "step": 1, "label": "Quantity", "default": 2 },
        { "type": "text", "id": "price_text", "label": "Price display", "default": "$63" },
        { "type": "text", "id": "compare_text", "label": "Compare text", "default": "$140 Per Pair" },
        { "type": "text", "id": "save_label", "label": "Save badge", "default": "Save 55%" }
      ]
    },
    {
      "type": "accordion",
      "name": "Feature accordion",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "feather", "label": "Feather" },
            { "value": "foot", "label": "Foot" },
            { "value": "blood", "label": "Blood" },
            { "value": "toe", "label": "Toe box" },
            { "value": "gear", "label": "Gear" }
          ],
          "default": "feather"
        },
        { "type": "text", "id": "title", "label": "Title", "default": "Breathable Material" },
        { "type": "richtext", "id": "content", "label": "Content", "default": "<p>Lightweight mesh keeps feet cool and comfortable all day.</p>" }
      ]
    },
    {
      "type": "ugc_image",
      "name": "UGC image",
      "settings": [{ "type": "image_picker", "id": "image", "label": "Image" }]
