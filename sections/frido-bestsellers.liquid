{%- liquid
  assign coll = section.settings.collection
  assign limit = section.settings.products_to_show | default: 8
-%}

<div class="frido-collection frido-bestsellers{% if section.settings.compact_layout %} frido-bestsellers--compact{% endif %} color-{{ section.settings.color_scheme }} gradient">
  <div class="frido-page-width">
    <div class="frido-section-head frido-bestsellers__head">
      {% if section.settings.title != blank %}
        <h2>{{ section.settings.title | escape }}</h2>
      {% endif %}
      {% if section.settings.show_view_all and section.settings.view_all_label != blank %}
        <a
          href="{{ coll.url | default: routes.all_products_collection_url }}"
          class="frido-btn frido-btn--outline frido-bestsellers__shop-all frido-bestsellers__shop-all--desktop"
        >
          {{ section.settings.view_all_label | escape }}
        </a>
      {% endif %}
    </div>

    <div class="frido-collection__grid frido-bestsellers__grid{% if section.settings.swipe_mobile %} frido-collection--peek{% endif %}">
      {% if coll != blank and coll.products_count > 0 %}
        {% for product in coll.products limit: limit %}
          {% render 'frido-product-card', card_product: product, pdp_rec: section.settings.compact_layout %}
        {% endfor %}
      {% else %}
        {% for i in (1..4) %}
          <div class="frido-pcard" style="opacity:0.85">
            <div class="frido-pcard__img">{{ 'product-apparel-2' | placeholder_svg_tag: 'class="placeholder-svg"' }}</div>
            <div class="frido-pcard__body">
              <div class="frido-pcard__cat">WOMEN</div>
              <h3 class="frido-pcard__title">Frido bestseller</h3>
              <div class="frido-pcard__row">{% render 'frido-stars', rating: 5 %}<span class="frido-stars__label">(0)</span></div>
              <div class="frido-pcard__row" style="margin-top:0.6rem">
                <span class="frido-pcard__price">{{ 1999 | money }}</span>
                <span class="frido-pcard__compare">{{ 3999 | money }}</span>
              </div>
            </div>
          </div>
        {% endfor %}
      {% endif %}
    </div>

    {% if section.settings.show_view_all and section.settings.view_all_label != blank %}
      <div class="frido-bestsellers__footer">
        <a
          href="{{ coll.url | default: routes.all_products_collection_url }}"
          class="frido-btn frido-btn--outline frido-bestsellers__shop-all frido-bestsellers__shop-all--mobile"
        >
          {{ section.settings.view_all_label | escape }}
        </a>
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Frido — bestsellers",
  "tag": "section",
  "class": "section-frido-bestsellers",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    { "type": "text", "id": "title", "label": "Heading", "default": "Bestsellers" },
    { "type": "text", "id": "view_all_label", "label": "View all label", "default": "SHOP ALL" },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show view all link",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "compact_layout",
      "label": "Compact layout (FAQ / recs style)",
      "info": "Gray section background, green sale badges, red prices, hides view all when unchecked above."
    },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "products_to_show", "min": 4, "max": 12, "step": 1, "default": 8, "label": "Products" },
    { "type": "checkbox", "id": "swipe_mobile", "label": "Horizontal scroll on mobile", "default": true }
  ],
  "presets": [{ "name": "Frido — bestsellers" }]
}
{% endschema %}
