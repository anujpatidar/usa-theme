{% comment %} Frido homepage hero — desktop split + mobile stack (CTA order) {% endcomment %}

<div class="frido-hero">
  <div class="frido-page-width">
    <div class="frido-hero__grid">
      <div class="frido-hero__media">
        {% if section.settings.image != blank %}
          {%- assign hero_alt = section.settings.image.alt | default: section.settings.heading | escape -%}
          {{
            section.settings.image
            | image_url: width: 1600
            | image_tag: loading: 'eager', widths: '750,1100,1400,1600', sizes: '(min-width: 990px) 50vw, 100vw', alt: hero_alt
          }}
        {% else %}
          {{ 'lifestyle-2' | placeholder_svg_tag: 'class="placeholder-svg"' }}
        {% endif %}
        <div class="frido-hero__badges">
          {% if section.settings.badge_1 != blank %}
            <span class="frido-hero__badge">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="var(--frido-blue)" stroke-width="2.5"><path d="M5 12l4 4L19 7"/></svg>
              {{ section.settings.badge_1 | escape }}
            </span>
          {% endif %}
          {% if section.settings.badge_2 != blank %}
            <span class="frido-hero__badge">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="var(--frido-blue)" stroke-width="2.5"><path d="M5 12l4 4L19 7"/></svg>
              {{ section.settings.badge_2 | escape }}
            </span>
          {% endif %}
        </div>
        {% if section.settings.overlay_prefix != blank or section.settings.overlay_highlight != blank %}
          <div class="frido-hero__overlay">
            {{ section.settings.overlay_prefix | escape }}
            {% if section.settings.overlay_highlight != blank %}
              <em>{{ section.settings.overlay_highlight | escape }}</em>
            {% endif %}
            {{ section.settings.overlay_suffix | escape }}
          </div>
        {% endif %}
      </div>

      <div class="frido-hero__content">
        <div class="frido-hero__rating frido-hero__rating-row">
          <span class="frido-hero__pill-rating">
            {% render 'frido-stars', rating: 5 %}
            <span class="frido-stars__label">{{ section.settings.rating_line | escape }}</span>
          </span>
        </div>

        <div class="frido-hero__headings">
          {% if section.settings.heading != blank %}
            <h1 class="frido-hero__h1">{{ section.settings.heading | escape }}</h1>
          {% endif %}
          {% if section.settings.subheading != blank %}
            <p class="frido-hero__sub">{{ section.settings.subheading | escape }}</p>
          {% endif %}
        </div>

        {% if section.blocks.size > 0 %}
          <div class="frido-hero__features frido-feature-grid">
            {% for block in section.blocks %}
              {% if block.type == 'feature' %}
                <div {{ block.shopify_attributes }}>
                  {% render 'frido-feature-circle', title: block.settings.title, icon: block.settings.icon %}
                </div>
              {% endif %}
            {% endfor %}
          </div>
        {% endif %}

        <div class="frido-hero__cta">
          {% render 'frido-button',
            label: section.settings.cta_label,
            url: section.settings.cta_link,
            style: 'blue',
            wide: true,
            show_arrow: true
          %}
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Frido — hero",
  "tag": "section",
  "class": "section-frido-hero",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Hero image" },
    { "type": "text", "id": "badge_1", "label": "Badge 1", "default": "FREE SHIPPING" },
    { "type": "text", "id": "badge_2", "label": "Badge 2", "default": "30-DAY GUARANTEE" },
    { "type": "text", "id": "overlay_prefix", "label": "Overlay — before highlight", "default": "UP TO" },
    { "type": "text", "id": "overlay_highlight", "label": "Overlay — highlight", "default": "50%" },
    { "type": "text", "id": "overlay_suffix", "label": "Overlay — after highlight", "default": "OFF ON BESTSELLERS" },
    { "type": "text", "id": "rating_line", "label": "Rating line", "default": "2M+ lives improved" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Healthy Barefoot Shoes" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Your path to pain-free walking" },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "SHOP BESTSELLERS" },
    { "type": "url", "id": "cta_link", "label": "Button link" }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Wide Toe Box" },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "foot", "label": "Foot" },
            { "value": "align", "label": "Alignment" },
            { "value": "flex", "label": "Flexible" },
            { "value": "sole", "label": "Sole" }
          ],
          "default": "foot"
        }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Frido — hero",
      "blocks": [
        { "type": "feature", "settings": { "title": "Wide Toe Box", "icon": "foot" } },
        { "type": "feature", "settings": { "title": "Natural Alignment", "icon": "align" } },
        { "type": "feature", "settings": { "title": "Zero Drop", "icon": "sole" } },
        { "type": "feature", "settings": { "title": "Light & Flexible", "icon": "flex" } }
      ]
    }
  ]
}
{% endschema %}
