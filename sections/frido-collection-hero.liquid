{{ 'frido-collection.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign hero_title = section.settings.title
  if hero_title == blank
    assign hero_title = collection.title
  endif

  assign mf_subtitle = collection.metafields.custom.subheading
  assign hero_subtitle = mf_subtitle.value | default: mf_subtitle
  if hero_subtitle == blank
    assign hero_subtitle = section.settings.subtitle
  endif

  assign mf_description = collection.metafields.custom.hero_description
  assign has_mf_description = false
  if mf_description != blank
    assign has_mf_description = true
  endif

-%}

<section class="frido-col-hero color-{{ section.settings.color_scheme }} gradient" id="frido-col-hero-{{ section.id }}">
  <div class="frido-page-width frido-col-hero__grid">
    <div class="frido-col-hero__content">
      <h1 class="frido-col-hero__title">{{ hero_title | escape }}</h1>
      {% if hero_subtitle != blank %}
        <p class="frido-col-hero__subtitle">{{ hero_subtitle | escape }}</p>
      {% endif %}

      <div
        class="frido-col-hero__desc"
        data-frido-col-desc
        style="--frido-col-desc-lines: {{ section.settings.description_lines | default: 4 }};"
      >
        {% if has_mf_description %}
          <div class="frido-col-hero__richtext rte">
            {{ mf_description | metafield_tag }}
          </div>
        {% elsif section.settings.description != blank %}
          <div class="frido-col-hero__richtext rte">
            {{ section.settings.description }}
          </div>
        {% elsif collection.description != blank %}
          <div class="frido-col-hero__richtext rte">
            {{ collection.description }}
          </div>
        {% endif %}
      </div>

      <button
        type="button"
        class="frido-col-hero__more"
        data-frido-col-more
        aria-expanded="false"
        hidden
      >
        {{ section.settings.show_more_label | default: 'SHOW MORE' | escape }}
      </button>

      {% if section.blocks.size > 0 %}
        <div class="frido-col-hero__features" data-frido-col-features>
          {% for block in section.blocks %}
            {% if block.type == 'feature' %}
              <div {{ block.shopify_attributes }}>
                {% render 'frido-col-feature',
                  title: block.settings.title,
                  icon: block.settings.icon,
                  icon_image: block.settings.icon_image
                %}
              </div>
            {% endif %}
          {% endfor %}
        </div>
      {% endif %}
    </div>

    <div class="frido-col-hero__media">
      {%- liquid
        assign banner_desktop = section.settings.image | default: collection.image
        assign banner_mobile = section.settings.image_mobile
        if banner_desktop == blank and banner_mobile != blank
          assign banner_desktop = banner_mobile
        endif
      -%}
      {% if banner_desktop != blank or banner_mobile != blank %}
        {%- assign hero_alt = banner_desktop.alt | default: banner_mobile.alt | default: hero_title | escape -%}
        <picture>
          {%- if banner_mobile != blank -%}
            <source
              media="(max-width: 989px)"
              srcset="
                {{ banner_mobile | image_url: width: 750 }} 750w,
                {{ banner_mobile | image_url: width: 1100 }} 1100w
              "
              sizes="100vw"
            >
          {%- endif -%}
          {{
            banner_desktop
            | image_url: width: 1400
            | image_tag:
              loading: 'eager',
              widths: '750,1100,1400',
              sizes: '(min-width: 990px) 50vw, 100vw',
              alt: hero_alt,
              class: 'frido-col-hero__img'
          }}
        </picture>
      {% else %}
        {{ 'lifestyle-2' | placeholder_svg_tag: 'frido-col-hero__img placeholder-svg' }}
      {% endif %}

      {% if section.settings.overlay_highlight != blank or section.settings.overlay_prefix != blank %}
        <div class="frido-col-hero__overlay">
          {{ section.settings.overlay_prefix | escape }}
          {% if section.settings.overlay_highlight != blank %}
            <em>{{ section.settings.overlay_highlight | escape }}</em>
          {% endif %}
          {{ section.settings.overlay_suffix | escape }}
        </div>
      {% endif %}
    </div>
  </div>
</section>

<script>
  (function () {
    var root = document.getElementById('frido-col-hero-{{ section.id }}');
    if (!root) return;
    var desc = root.querySelector('[data-frido-col-desc]');
    var btn = root.querySelector('[data-frido-col-more]');
    if (!desc || !btn) return;
    var richtext = desc.querySelector('.frido-col-hero__richtext');
    if (!richtext) return;
    var collapsed = {{ section.settings.description_lines | default: section.settings.description_lines_mobile | default: 4 }};
    var style = window.getComputedStyle(richtext);
    var lineHeight = parseFloat(style.lineHeight);
    if (!lineHeight || Number.isNaN(lineHeight)) {
      lineHeight = parseFloat(style.fontSize) * 1.55;
    }
    if (richtext.scrollHeight > collapsed * lineHeight + 2) {
      root.classList.add('has-show-more');
      desc.classList.add('is-collapsed');
      btn.hidden = false;
      btn.addEventListener('click', function () {
        var open = desc.classList.toggle('is-open');
        root.classList.toggle('is-expanded', open);
        btn.setAttribute('aria-expanded', open ? 'true' : 'false');
        btn.textContent = open ? {{ section.settings.show_less_label | default: 'SHOW LESS' | json }} : {{ section.settings.show_more_label | default: 'SHOW MORE' | json }};
      });
    }
  })();
</script>

{% schema %}
{
  "name": "Frido — collection hero",
  "tag": "section",
  "class": "section-frido-col-hero",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "paragraph",
      "content": "Subheading and description are read from collection metafields: custom.subheading (Single line text) and custom.hero_description (Rich text). Theme settings below are fallbacks only."
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title (fallback)",
      "info": "Leave blank to use collection title."
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle (fallback)",
      "info": "Used only when custom.subheading metafield is empty."
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description (fallback)",
      "info": "Used only when custom.hero_description metafield is empty."
    },
    {
      "type": "range",
      "id": "description_lines",
      "min": 2,
      "max": 14,
      "step": 1,
      "label": "Description lines before Show more",
      "default": 4
    },
    {
      "type": "range",
      "id": "description_lines_mobile",
      "min": 2,
      "max": 8,
      "step": 1,
      "label": "Description lines before Show more (legacy mobile)",
      "info": "Deprecated — use “Description lines before Show more” above.",
      "default": 4
    },
    {
      "type": "text",
      "id": "show_more_label",
      "label": "Show more label",
      "default": "SHOW MORE"
    },
    {
      "type": "text",
      "id": "show_less_label",
      "label": "Show less label",
      "default": "SHOW LESS"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Banner image (desktop)"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Banner image (mobile)",
      "info": "Shown below 990px. Uses desktop/collection image if empty."
    },
    {
      "type": "text",
      "id": "overlay_prefix",
      "label": "Image overlay — before highlight",
      "default": "UP TO"
    },
    {
      "type": "text",
      "id": "overlay_highlight",
      "label": "Image overlay — highlight",
      "default": "50%"
    },
    {
      "type": "text",
      "id": "overlay_suffix",
      "label": "Image overlay — after highlight",
      "default": "OFF ON BESTSELLERS"
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature icon",
      "settings": [
        { "type": "text", "id": "title", "label": "Label", "default": "Wide Toe Box" },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "foot", "label": "Foot" },
            { "value": "align", "label": "Alignment" },
            { "value": "flex", "label": "Flexible" },
            { "value": "sole", "label": "Sole" }
          ],
          "default": "foot"
        },
        { "type": "image_picker", "id": "icon_image", "label": "Icon image (optional)" }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Frido — collection hero",
      "blocks": [
        { "type": "feature", "settings": { "title": "Breathable Material", "icon": "flex" } },
        { "type": "feature", "settings": { "title": "Wide Toe Box", "icon": "foot" } },
        { "type": "feature", "settings": { "title": "Natural Gait", "icon": "align" } },
        { "type": "feature", "settings": { "title": "Zero Drop Sole", "icon": "sole" } }
      ]
    }
  ]
}
{% endschema %}
