<div class="frido-split color-{{ section.settings.color_scheme }} gradient">
  <div class="frido-page-width">
    <div class="frido-split__shell">
      <div class="frido-split__grid{% if section.settings.image_position == 'right' %} frido-split__grid--media-right{% endif %}">
        <div class="frido-split__media">
          {% if section.settings.image != blank %}
            {%- assign split_alt = section.settings.image.alt | default: section.settings.heading | escape -%}
            {{
              section.settings.image
              | image_url: width: 1400
              | image_tag:
                loading: 'lazy',
                class: 'frido-split__img',
                widths: '550,750,990,1100,1400',
                sizes: '(min-width: 990px) 50vw, 100vw',
                alt: split_alt
            }}
          {% else %}
            {{ 'lifestyle-1' | placeholder_svg_tag: 'class="placeholder-svg frido-split__img"' }}
          {% endif %}
        </div>

        <div class="frido-split__prose">
          {% if section.settings.heading != blank %}
            <h2 class="frido-split__heading">{{ section.settings.heading | escape }}</h2>
          {% endif %}
          {% if section.settings.body != blank %}
            <div class="frido-split__body rte">{{ section.settings.body }}</div>
          {% endif %}
          {% if section.blocks.size > 0 %}
            <div class="frido-feature-list frido-split__features">
              {% for block in section.blocks %}
                {% if block.type == 'feature' %}
                  <div class="frido-split__feature" {{ block.shopify_attributes }}>
                    {% render 'frido-feature-item',
                      title: block.settings.title,
                      text: block.settings.text,
                      icon: block.settings.icon,
                      icon_image: block.settings.icon_image,
                      icon_size: 72,
                      layout: 'split'
                    %}
                  </div>
                {% endif %}
              {% endfor %}
            </div>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Frido — image & features",
  "tag": "section",
  "class": "section-frido-split",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Desktop image position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    { "type": "image_picker", "id": "image", "label": "Image" },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Experience ultimate foot comfort with Frido!"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Text",
      "default": "<p>At Frido, our mission is personal: we aim to enhance your foot health and ease your foot pain. Our supportive, high-quality footwear is designed for natural foot alignment and all-day comfort with every step.</p>"
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Wide Toe Box" },
        {
          "type": "textarea",
          "id": "text",
          "label": "Description",
          "default": "Give your toes room to relax in their natural position with our wide toe box."
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon (if no image)",
          "options": [
            { "value": "foot", "label": "Foot" },
            { "value": "align", "label": "Alignment" },
            { "value": "flex", "label": "Flexible" },
            { "value": "sole", "label": "Sole" }
          ],
          "default": "foot"
        },
        {
          "type": "image_picker",
          "id": "icon_image",
          "label": "Feature icon image",
          "info": "Optional. Upload PNG/SVG from the library."
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Frido — image & features",
      "blocks": [
        {
          "type": "feature",
          "settings": {
            "title": "Wide Toe Box",
            "text": "Give your toes room to relax in their natural position with our wide toe box.",
            "icon": "foot"
          }
        },
        {
          "type": "feature",
          "settings": {
            "title": "Thin Soles",
            "text": "Feel truly connected with our ultra-thin soles for a barefoot sensation.",
            "icon": "sole"
          }
        },
        {
          "type": "feature",
          "settings": {
            "title": "Natural Comfort",
            "text": "Experience natural comfort, support, and pain prevention with our footwear.",
            "icon": "flex"
          }
        }
      ]
    }
  ]
}
{% endschema %}
