{% comment %} Frido — site header (announcement + mega menu) {% endcomment %}
{% liquid
  assign menu = section.settings.menu
  assign sale_url = section.settings.sale_link | default: routes.all_products_collection_url
%}

<div id="FridoSiteHeader" class="frido-site-header">
  <div class="frido-announcement-wrap color-{{ section.settings.color_scheme }} gradient">
    {% render 'frido-announcement-bar', section: section %}
  </div>

  <header class="frido-header color-{{ section.settings.color_scheme }} gradient" data-section-id="{{ section.id }}">
  <div class="frido-header__shell">
    <div class="frido-page-width">
      <div class="frido-header__main frido-header__bar frido-header__bar--mobile">
        <div class="frido-header__mobile-left">
          <button
            type="button"
            class="frido-header__icon-btn"
            data-frido-menu-toggle
            aria-controls="FridoMenu-{{ section.id }}"
            aria-expanded="false"
            aria-label="{{ 'sections.header.menu' | t }}"
          >
            <svg class="frido-header__menu-icon frido-header__menu-icon--open" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M4 6h16M4 12h16M4 18h16"/>
            </svg>
            <svg class="frido-header__menu-icon frido-header__menu-icon--close" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M6 6l12 12M18 6L6 18"/>
            </svg>
          </button>
          <button
            type="button"
            class="frido-header__icon-btn frido-search__mobile-trigger"
            data-frido-search-mobile-open
            data-frido-search-trigger="{{ section.id }}"
            aria-label="{{ 'general.search.search' | t }}"
            aria-expanded="false"
            aria-controls="FridoSearchPanel-{{ section.id }}"
          >
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <circle cx="11" cy="11" r="7"/><path d="M20 20l-4-4"/>
            </svg>
          </button>
        </div>
        {% render 'frido-header-logo',
          url: routes.root_url,
          image: section.settings.logo_image,
          text: section.settings.logo_text,
          subtitle: section.settings.logo_subtitle,
          max_width: section.settings.logo_max_width,
          show_subtitle: true,
          mobile_center: true
        %}
        <div class="frido-header__mobile-tools">
          {% render 'frido-header-cart-btn', section: section, icon_size: 22 %}
          <span class="frido-header__icon-btn frido-header__region" aria-hidden="true">
            {% if section.settings.region_icon != blank %}
              {{
                section.settings.region_icon
                | image_url: width: 64
                | image_tag: loading: 'lazy', class: 'frido-header__region-img', widths: '32,48,64', sizes: '28px', alt: ''
              }}
            {% else %}
              <svg width="22" height="16" viewBox="0 0 22 16" aria-hidden="true"><rect width="22" height="16" fill="#B22234"/><path stroke="#fff" stroke-width="1.2" d="M0 2h22M0 4h22M0 6h22M0 8h22M0 10h22M0 12h22M0 14h22"/><rect width="9" height="8" fill="#3C3B6E"/></svg>
            {% endif %}
          </span>
          {% render 'frido-header-account-btn', section: section, icon_size: 22 %}
        </div>
      </div>

      <div class="frido-header__main frido-header__bar frido-header__bar--desktop">
        {% render 'frido-header-logo',
          url: routes.root_url,
          image: section.settings.logo_image,
          text: section.settings.logo_text,
          subtitle: section.settings.logo_subtitle,
          max_width: section.settings.logo_max_width,
          show_subtitle: true,
          mobile_center: false
        %}

        {% if menu != blank and menu.links.size > 0 %}
          <nav class="frido-header__nav-desktop" aria-label="{{ 'sections.header.menu' | t }}">
            <ul class="frido-header__nav-list">
              <li class="frido-header__nav-item">
                <a class="frido-header__sale-pill" href="{{ sale_url }}">{{ section.settings.sale_label | escape }}</a>
              </li>
              {% for link in menu.links %}
                {% assign has_mega = false %}
                {% if link.links != blank %}{% assign has_mega = true %}{% endif %}
                {%- if has_mega -%}
                  {%- assign mega_id = 'FridoMega-' | append: section.id | append: '-' | append: forloop.index -%}
                {%- endif -%}
                <li
                  class="frido-header__nav-item{% if has_mega %} frido-header__nav-item--mega{% endif %}"
                  {% if has_mega %}data-mega-panel="{{ mega_id }}"{% endif %}
                >
                  <a
                    href="{{ link.url }}"
                    class="frido-header__nav-link{% if has_mega %} frido-header__nav-link--has-mega{% endif %}"
                    {% if has_mega %}aria-haspopup="true" aria-expanded="false" aria-controls="{{ mega_id }}"{% endif %}
                  >
                    {{ link.title | escape }}
                    {% if has_mega %}
                      <svg class="frido-header__chevron" width="10" height="10" viewBox="0 0 12 12" fill="currentColor" aria-hidden="true"><path d="M2 4l4 4 4-4"/></svg>
                    {% endif %}
                  </a>
                </li>
              {% endfor %}
            </ul>
          </nav>
        {% endif %}

        <div class="frido-header__actions">
          {% render 'frido-search-desktop-form', section: section %}
          <div class="frido-header__desktop-tools">
            {% render 'frido-header-cart-btn', section: section, icon_size: 24 %}
            <span class="frido-header__icon-btn frido-header__region" aria-hidden="true">
              {% if section.settings.region_icon != blank %}
                {{
                  section.settings.region_icon
                  | image_url: width: 64
                  | image_tag: loading: 'lazy', class: 'frido-header__region-img', widths: '32,48,64', sizes: '28px', alt: ''
                }}
              {% else %}
                <svg width="24" height="17" viewBox="0 0 22 16" aria-hidden="true"><rect width="22" height="16" fill="#B22234"/><path stroke="#fff" stroke-width="1.2" d="M0 2h22M0 4h22M0 6h22M0 8h22M0 10h22M0 12h22M0 14h22"/><rect width="9" height="8" fill="#3C3B6E"/></svg>
              {% endif %}
            </span>
            {% render 'frido-header-account-btn', section: section, icon_size: 24 %}
          </div>
        </div>
      </div>
    </div>

    {%- if menu != blank -%}
      <div class="frido-header__mega-zone">
        {%- for link in menu.links -%}
          {%- if link.links != blank -%}
            {%- assign mega_id = 'FridoMega-' | append: section.id | append: '-' | append: forloop.index -%}
            {% render 'frido-header-mega', link: link, section: section, panel_id: mega_id %}
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>

  {% render 'frido-search-panel', section: section %}

  <div
    id="FridoMenu-{{ section.id }}"
    class="frido-menu-panel color-{{ section.settings.color_scheme }} gradient"
    role="dialog"
    aria-modal="true"
    aria-label="{{ 'sections.header.menu' | t }}"
  >
    <div class="frido-menu-panel__inner">
      <div class="frido-menu-panel__view frido-menu-panel__view--root is-active" data-menu-view="root">
        <div class="frido-menu-panel__scroll">
          <form class="frido-menu-panel__search" action="{{ routes.search_url }}" method="get" role="search">
            <span class="frido-menu-panel__search-icon" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="11" cy="11" r="7"/><path d="M20 20l-4-4"/>
              </svg>
            </span>
            <input type="search" name="q" placeholder="{{ 'general.search.search' | t }}" value="{{ search.terms | escape }}">
          </form>

          <a class="frido-header__sale-pill frido-header__sale-pill--menu" href="{{ sale_url }}">
            {{ section.settings.sale_label | escape }}
          </a>

          <ul class="frido-menu-panel__list">
            {% if menu != blank %}
              {% for link in menu.links %}
                {%- liquid
                  assign skip_link = false
                  if section.settings.mobile_hide_home
                    if link.title == 'Home' or link.url == routes.root_url
                      assign skip_link = true
                    endif
                  endif
                -%}
                {% unless skip_link %}
                  <li>
                    {% if link.links != blank %}
                      <button
                        type="button"
                        class="frido-menu-panel__trigger"
                        data-mobile-open-sub="{{ link.title | handleize }}"
                      >
                        <span>{{ link.title | escape }}</span>
                        <svg class="frido-menu-panel__chevron" width="8" height="14" viewBox="0 0 8 14" fill="none" aria-hidden="true">
                          <path d="M1 1l6 6-6 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                      </button>
                    {% else %}
                      <a href="{{ link.url }}" class="frido-menu-panel__link">
                        <span>{{ link.title | escape }}</span>
                      </a>
                    {% endif %}
                  </li>
                {% endunless %}
              {% endfor %}
            {% endif %}
          </ul>
        </div>
      </div>

      {% if menu != blank %}
        {% for link in menu.links %}
          {% if link.links != blank %}
            {% assign sub_id = 'FridoSub-' | append: section.id | append: '-' | append: forloop.index %}
            {% render 'frido-header-mobile-sub', link: link, section: section, panel_id: sub_id %}
          {% endif %}
        {% endfor %}
      {% endif %}
    </div>
  </div>
  </header>
</div>

{% render 'frido-account-drawer', section: section %}

{{ 'frido-search.css' | asset_url | stylesheet_tag }}
{{ 'frido-account-drawer.css' | asset_url | stylesheet_tag }}
<script src="{{ 'frido-search.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'frido-account-drawer.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Frido header",
  "class": "section-frido-header",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "richtext",
      "id": "announcement",
      "label": "Announcement (fallback)",
      "info": "Used only when no announcement message blocks are added below.",
      "default": "<p>30-day money-back guarantee</p>"
    },
    {
      "type": "range",
      "id": "announcement_interval",
      "min": 3,
      "max": 5,
      "step": 1,
      "unit": "s",
      "label": "Seconds between messages",
      "default": 4
    },
    {
      "type": "range",
      "id": "announcement_fade_duration",
      "min": 300,
      "max": 800,
      "step": 100,
      "label": "Fade animation (ms)",
      "default": 500
    },
    { "type": "url", "id": "help_url", "label": "Help link" },
    { "type": "url", "id": "track_url", "label": "Track order link" },
    {
      "type": "header",
      "content": "Search overlay"
    },
    {
      "type": "text",
      "id": "search_placeholder",
      "label": "Search placeholder",
      "default": "Search"
    },
    {
      "type": "collection",
      "id": "search_trending_collection",
      "label": "Trending products collection"
    },
    {
      "type": "text",
      "id": "search_trending_title",
      "label": "Trending heading",
      "default": "Trending Now"
    },
    {
      "type": "text",
      "id": "search_bestsellers_label",
      "label": "Trending CTA label",
      "default": "Shop Best Sellers"
    },
    {
      "type": "url",
      "id": "search_bestsellers_link",
      "label": "Trending CTA link"
    },
    {
      "type": "text",
      "id": "search_popular_title",
      "label": "Popular searches heading",
      "default": "Popular Searches"
    },
    {
      "type": "textarea",
      "id": "search_popular_terms",
      "label": "Popular search terms (one per line)",
      "default": "ergonomic\nbarefoot\nsocks\nlorax\ncaspian"
    },
    {
      "type": "text",
      "id": "search_helpful_title",
      "label": "Helpful links heading",
      "default": "Helpful Links"
    },
    {
      "type": "link_list",
      "id": "search_help_menu",
      "label": "Helpful links menu"
    },
    {
      "type": "image_picker",
      "id": "logo_image",
      "label": "Logo image"
    },
    {
      "type": "range",
      "id": "logo_max_width",
      "min": 80,
      "max": 320,
      "step": 4,
      "unit": "px",
      "label": "Logo max width",
      "default": 180
    },
    { "type": "text", "id": "logo_text", "label": "Logo text (fallback)", "default": "Frido" },
    { "type": "text", "id": "logo_subtitle", "label": "Logo subtitle", "default": "FOOTWEAR" },
    {
      "type": "image_picker",
      "id": "region_icon",
      "label": "Region / country icon"
    },
  { "type": "link_list", "id": "menu", "label": "Menu", "info": "Use 3 levels: top link → column heading → links. Column titles containing 'Category' or 'Activity' enable image tiles from blocks below." },
    { "type": "text", "id": "sale_label", "label": "Sale pill label", "default": "Summer Sale" },
    { "type": "url", "id": "sale_link", "label": "Sale pill link" },
    {
      "type": "checkbox",
      "id": "mobile_hide_home",
      "label": "Hide Home in mobile menu",
      "default": true,
      "info": "Matches HIKE-style drawer (logo links home via header)."
    },
    {
      "type": "header",
      "content": "Account drawer"
    },
    {
      "type": "text",
      "id": "account_welcome_heading",
      "label": "Welcome heading",
      "default": "Welcome to Frido"
    },
    {
      "type": "textarea",
      "id": "account_welcome_text",
      "label": "Welcome description",
      "default": "Log in or register to track orders, checkout faster, receive all our latest news and more."
    },
    {
      "type": "text",
      "id": "account_login_tab",
      "label": "Login tab label",
      "default": "Login"
    },
    {
      "type": "text",
      "id": "account_register_tab",
      "label": "Create account tab label",
      "default": "Create Account"
    },
    {
      "type": "text",
      "id": "account_sign_in_label",
      "label": "Sign in button",
      "default": "SIGN IN"
    },
    {
      "type": "text",
      "id": "account_create_label",
      "label": "Create account button",
      "default": "CREATE ACCOUNT"
    }
  ],
  "blocks": [
    {
      "type": "announcement_message",
      "name": "Announcement message",
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "Message",
          "default": "<p>30-day money-back guarantee</p>"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link (optional)"
        }
      ]
    },
    {
      "type": "mega_featured",
      "name": "Mega menu featured",
      "settings": [
        { "type": "text", "id": "menu_item", "label": "Top menu item", "info": "Match title exactly, e.g. Women or Categories" },
        { "type": "text", "id": "column_heading", "label": "Column heading", "default": "Featured" },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "title", "label": "Caption", "default": "New Arrivals" },
        { "type": "url", "id": "url", "label": "Link" }
      ]
    },
    {
      "type": "nav_tile",
      "name": "Mobile nav tile",
      "settings": [
        { "type": "text", "id": "menu_item", "label": "Top menu item", "default": "Women" },
        {
          "type": "select",
          "id": "group",
          "label": "Section",
          "options": [
            { "value": "category", "label": "Category" },
            { "value": "activity", "label": "Activity" }
          ],
          "default": "category"
        },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "title", "label": "Label", "default": "Barefoot Shoes" },
        { "type": "url", "id": "url", "label": "Link" }
      ]
    },
    {
      "type": "nav_badge",
      "name": "Link badge",
      "settings": [
        { "type": "text", "id": "menu_item", "label": "Top menu item", "default": "Women" },
        { "type": "text", "id": "link_title", "label": "Link title", "default": "Bestsellers" },
        { "type": "text", "id": "badge_text", "label": "Badge text", "default": "Up to 50% OFF" }
      ]
    },
    {
      "type": "mega_product_card",
      "name": "Mega menu product card",
      "settings": [
        { "type": "text", "id": "menu_item", "label": "Top menu item", "default": "Conditions", "info": "Shows in Featured column when that column has no links (Conditions mega menu)." },
        { "type": "product", "id": "product", "label": "Product" },
        { "type": "image_picker", "id": "image", "label": "Image override" },
        { "type": "text", "id": "title", "label": "Title override" },
        { "type": "url", "id": "url", "label": "Link override" },
        { "type": "text", "id": "review_count", "label": "Review count label", "default": "(6,432)", "info": "Shown after stars, e.g. (6,432)" },
        { "type": "range", "id": "rating", "min": 1, "max": 5, "step": 1, "label": "Star rating", "default": 5 }
      ]
    }
  ],
  "presets": [{ "name": "Frido header" }]
}
{% endschema %}
