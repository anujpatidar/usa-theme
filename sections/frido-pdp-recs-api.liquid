{% comment %}
  Fragment for Product Recommendations API — do not add to templates directly.
{% endcomment %}
{%- if recommendations.performed and recommendations.products_count > 0 -%}
  <div data-frido-pdp-recs-content>
    {%- assign rec_limit = 4 -%}
    {%- if request.params.limit -%}
      {%- assign rec_limit = request.params.limit | plus: 0 -%}
    {%- endif -%}
    <div class="frido-pdp-recs__grid" role="list">
      {%- assign rec_count = 0 -%}
      {%- for card_product in recommendations.products -%}
        {%- if rec_count >= rec_limit -%}
          {%- break -%}
        {%- endif -%}
        {%- if card_product.id == product.id -%}
          {%- continue -%}
        {%- endif -%}
        <div class="frido-pdp-recs__cell" role="listitem">
          {% render 'frido-product-card', card_product: card_product, show_swatches: false, pdp_rec: true %}
        </div>
        {%- assign rec_count = rec_count | plus: 1 -%}
      {%- endfor -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "PDP recommendations API",
  "settings": []
}
{% endschema %}
