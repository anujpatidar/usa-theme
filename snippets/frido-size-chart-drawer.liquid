{% comment %}
  Size & Fit Chart — right-side drawer (PDP).
  @param section {Section}
  @param product {Product}
{% endcomment %}
{%- liquid
  assign chart_enabled = section.settings.size_chart_enable
  if chart_enabled == nil
    assign chart_enabled = true
  endif

  assign chart_title = section.settings.size_chart_title | default: 'Size & Fit Chart'
  assign chart_product_title = section.settings.size_chart_product_title | default: product.title
  assign rec_prefix = section.settings.size_chart_rec_prefix | default: 'Recommended Size:'

  assign chart_source = product
  assign chart_ref = product.metafields.custom.size_chart_product.value
  if chart_ref != blank
    assign chart_source = chart_ref
  endif

  assign chart_gender = 'unknown'
  assign gender_meta = chart_source.metafields.custom.gender.value | default: chart_source.metafields.custom.gender | downcase | strip
  assign handle = chart_source.handle | downcase

  case handle
    when 'frido-active-casual-sneakers-womens', 'frido-active-walking-shoes-womens', 'frido-womens-cloud-comfort-shoes-lace-ups'
      assign chart_gender = 'women'
    when 'frido-active-casual-sneakers-mens', 'frido-active-walking-shoes-mens', 'frido-cloud-comfort-shoes-with-lace', 'frido-cloud-comfort-slip-on-shoes', 'frido-comfort-dress-shoes'
      assign chart_gender = 'men'
    when 'frido-kids-cloud-comfort-shoes-lace-ups'
      assign chart_gender = 'kids'
  endcase

  if chart_gender == 'unknown'
    if gender_meta == 'women' or gender_meta == 'woman' or gender_meta == 'w' or gender_meta == 'female'
      assign chart_gender = 'women'
    elsif gender_meta == 'men' or gender_meta == 'man' or gender_meta == 'm' or gender_meta == 'male'
      assign chart_gender = 'men'
    elsif handle contains 'womens' or handle contains 'women'
      assign chart_gender = 'women'
    elsif handle contains 'kids'
      assign chart_gender = 'kids'
    elsif handle contains 'mens' or handle contains '-men'
      assign chart_gender = 'men'
    endif
  endif

  if chart_gender == 'unknown'
    assign chart_gender = 'men'
  endif

  if chart_gender == 'women'
    assign chart_subtitle = "Women's Size Chart"
  elsif chart_gender == 'kids'
    assign chart_subtitle = "Kids Size Chart"
  else
    assign chart_subtitle = "Men's Size Chart"
  endif

  assign custom_subtitle = product.metafields.custom.size_chart_subtitle.value | default: product.metafields.custom.size_chart_subtitle
  if custom_subtitle != blank
    assign chart_subtitle = custom_subtitle
  endif
-%}
{%- unless chart_enabled -%}
  {%- comment -%} Size chart disabled in section settings {%- endcomment -%}
{%- else -%}

<div
  id="frido-size-chart-{{ section.id }}"
  class="frido-size-chart"
  data-frido-size-chart
  data-frido-chart-gender="{{ chart_gender }}"
  hidden
  aria-hidden="true"
>
  <div class="frido-size-chart__overlay" data-frido-size-chart-close tabindex="-1"></div>

  <div
    class="frido-size-chart__panel color-{{ section.settings.color_scheme }} gradient"
    role="dialog"
    aria-modal="true"
    aria-labelledby="FridoSizeChartTitle-{{ section.id }}"
    tabindex="-1"
  >
    <header class="frido-size-chart__header">
      <h2 id="FridoSizeChartTitle-{{ section.id }}" class="frido-size-chart__title">
        {{ chart_title | escape }}
      </h2>
      <button
        type="button"
        class="frido-size-chart__close"
        data-frido-size-chart-close
        aria-label="{{ 'accessibility.close' | t | default: 'Close' }}"
      >
        <span aria-hidden="true">&times;</span>
      </button>
    </header>

    <div class="frido-size-chart__body">
      <p class="frido-size-chart__recommended" data-frido-size-chart-recommended>
        <span class="frido-size-chart__recommended-label">{{ rec_prefix | escape }}</span>
        <span data-frido-size-chart-rec-value></span>
      </p>

      <div class="frido-size-chart__find-mobile">
        {% render 'frido-find-size-button', class: 'frido-find-size-btn--drawer', color_scheme: section.settings.color_scheme, section_id: section.id, product_id: product.id %}
      </div>

      {%- if section.settings.size_chart_recommendations != blank -%}
        <div class="frido-size-chart__rec-block">
          <h3 class="frido-size-chart__rec-heading">Sizing Recommendations</h3>
          <div class="frido-size-chart__rec-text rte">
            {{ section.settings.size_chart_recommendations }}
          </div>
        </div>
      {%- else -%}
        <div class="frido-size-chart__rec-block">
          <h3 class="frido-size-chart__rec-heading">Sizing Recommendations</h3>
          <p class="frido-size-chart__rec-text">
            Runs small — we recommend ordering <strong>one size up</strong> if you have high-instep feet, prefer a roomier fit, or plan to wear thicker socks.
          </p>
          <p class="frido-size-chart__rec-note">
            <em>Fit preference can vary from person to person, so the final choice depends on your comfort preference.</em>
          </p>
        </div>
      {%- endif -%}

      <div class="frido-size-chart__product">
        <h3 class="frido-size-chart__product-title">{{ chart_product_title | escape }}</h3>
        <p class="frido-size-chart__product-sub">{{ chart_subtitle | escape }}</p>
      </div>

      <div class="frido-size-chart__table-wrap rte">
        {%- if product.metafields.custom.size_chart_html != blank -%}
          {{ product.metafields.custom.size_chart_html.value | default: product.metafields.custom.size_chart_html }}
        {%- else -%}
          {% render 'frido-size-chart-table',
            product: product,
            chart_gender: chart_gender,
            table_class: 'frido-size-chart__table'
          %}
        {%- endif -%}
      </div>
    </div>
  </div>
</div>
{%- endunless -%}
