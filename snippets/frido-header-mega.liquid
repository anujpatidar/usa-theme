{% comment %}
  Desktop mega menu panel for a top-level menu link.
{% endcomment %}
{%- liquid
  assign link_handle = link.title | handleize
  assign featured_block = nil
  for block in section.blocks
    if block.type == 'mega_featured' and block.settings.menu_item != blank
      assign block_handle = block.settings.menu_item | handleize
      if block_handle == link_handle
        assign featured_block = block
        break
      endif
    endif
  endfor
-%}
<div id="{{ panel_id }}" class="frido-mega" role="region" aria-label="{{ link.title | escape }}" hidden>
  <div class="frido-mega__inner frido-page-width">
    <div class="frido-mega__grid">
      {%- for column in link.links -%}
        {%- liquid
          assign col_handle = column.title | handleize
          assign is_featured_col = false
          if col_handle contains 'featured'
            assign is_featured_col = true
          endif
        -%}
        <div class="frido-mega__col{% if is_featured_col %} frido-mega__col--featured{% endif %}">
          <p class="frido-mega__heading">{{ column.title | escape }}</p>
          <hr class="frido-mega__rule" aria-hidden="true">

          {%- if is_featured_col and column.links == blank -%}
            {%- if link_handle == 'conditions' -%}
              <div class="frido-mega__product-grid">
                {%- for block in section.blocks -%}
                  {%- if block.type == 'mega_product_card' and block.settings.menu_item != blank -%}
                    {%- assign mh = block.settings.menu_item | handleize -%}
                    {%- if mh == link_handle -%}
                      {%- assign card_product = block.settings.product -%}
                      {%- assign card_title = block.settings.title -%}
                      {%- if card_title == blank and card_product != blank -%}
                        {%- assign card_title = card_product.title -%}
                      {%- endif -%}
                      {%- assign card_url = block.settings.url -%}
                      {%- if card_url == blank and card_product != blank -%}
                        {%- assign card_url = card_product.url -%}
                      {%- endif -%}
                      <a href="{{ card_url | default: '#' }}" class="frido-mega__product-card" {{ block.shopify_attributes }}>
                        <div class="frido-mega__product-card-media">
                          {%- if block.settings.image != blank -%}
                            {{ block.settings.image | image_url: width: 200 | image_tag: loading: 'lazy', class: 'frido-mega__product-card-img', widths: '100,150,200', sizes: '80px', alt: card_title }}
                          {%- elsif card_product != blank and card_product.featured_image -%}
                            {{ card_product.featured_image | image_url: width: 200 | image_tag: loading: 'lazy', class: 'frido-mega__product-card-img', widths: '100,150,200', sizes: '80px', alt: card_title }}
                          {%- else -%}
                            {{ 'product-1' | placeholder_svg_tag: 'frido-mega__product-card-img frido-mega__product-card-img--ph' }}
                          {%- endif -%}
                        </div>
                        <div class="frido-mega__product-card-body">
                          {% render 'frido-stars', rating: block.settings.rating, label: block.settings.review_count %}
                          <span class="frido-mega__product-card-title">{{ card_title | default: 'Product' | escape }}</span>
                        </div>
                      </a>
                    {%- endif -%}
                  {%- endif -%}
                {%- endfor -%}
              </div>
            {%- elsif featured_block -%}
              <a href="{{ featured_block.settings.url | default: column.url | default: '#' }}" class="frido-mega__featured-card" {{ featured_block.shopify_attributes }}>
                {%- if featured_block.settings.image != blank -%}
                  {{ featured_block.settings.image | image_url: width: 600 | image_tag: loading: 'lazy', class: 'frido-mega__featured-img', widths: '300,400,600', sizes: '200px', alt: featured_block.settings.title }}
                {%- else -%}
                  {{ 'product-1' | placeholder_svg_tag: 'frido-mega__featured-img frido-mega__featured-img--placeholder' }}
                {%- endif -%}
                {%- if featured_block.settings.title != blank -%}
                  <span class="frido-mega__featured-label">{{ featured_block.settings.title | escape }}</span>
                {%- endif -%}
              </a>
            {%- elsif column.url != blank -%}
              <ul class="frido-mega__links">
                <li><a href="{{ column.url }}">{{ column.title | escape }}</a></li>
              </ul>
            {%- endif -%}
          {%- else -%}
            <ul class="frido-mega__links">
              {%- for item in column.links -%}
                {%- liquid
                  assign badge_text = ''
                  assign item_handle = item.title | handleize
                  for badge in section.blocks
                    if badge.type == 'nav_badge' and badge.settings.menu_item != blank
                      assign bh = badge.settings.menu_item | handleize
                      assign lh = badge.settings.link_title | handleize
                      if bh == link_handle and lh == item_handle
                        assign badge_text = badge.settings.badge_text
                        break
                      endif
                    endif
                  endfor
                -%}
                <li>
                  <a href="{{ item.url }}">
                    <span>{{ item.title | escape }}</span>
                    {%- if badge_text != blank -%}
                      <span class="frido-mega__badge">{{ badge_text | escape }}</span>
                    {%- endif -%}
                  </a>
                </li>
              {%- endfor -%}
            </ul>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>
