{% comment %}
  PDP price row — sale price + compare + save pill.
  @param price {Money}
  @param compare_at {Money}
  @param save_pct {Number}
{% endcomment %}
<div class="frido-pdp__price-row">
  <div class="frido-pdp__price-line">
    <span class="frido-pdp__price" data-frido-price>{{ price | money }}</span>
    {%- if compare_at > price -%}
      <span class="frido-pdp__compare" data-frido-compare>{{ compare_at | money }}</span>
    {%- else -%}
      <span class="frido-pdp__compare" data-frido-compare hidden></span>
    {%- endif -%}
  </div>
  <span class="frido-pdp__save-badge" data-frido-save-badge{% if save_pct <= 0 %} hidden{% endif %}>
    <span class="frido-pdp__save-badge-icon">{% render 'frido-icon-discount' %}</span>
    <span class="frido-pdp__save-badge-text" data-frido-save-badge-text>
      {%- if save_pct > 0 -%}Save {{ save_pct }}%{%- endif -%}
    </span>
  </span>
</div>
