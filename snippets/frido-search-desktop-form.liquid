{% comment %} Desktop header search input @param section {Section} {% endcomment %}
<form class="frido-header__search frido-search__form" action="{{ routes.search_url }}" method="get" role="search">
  <span class="frido-header__search-icon frido-search__icon" aria-hidden="true">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="M20 20l-4-4"/></svg>
  </span>
  <input
    type="search"
    name="q"
    class="frido-search__input"
    data-frido-search-input
    placeholder="{{ section.settings.search_placeholder | default: 'Search' | escape }}"
    value="{{ search.terms | escape }}"
    autocomplete="off"
    autocorrect="off"
    autocapitalize="off"
    spellcheck="false"
    aria-controls="FridoSearchPanel-{{ section.id }}"
    aria-expanded="false"
    aria-autocomplete="list"
  >
  <input type="hidden" name="options[prefix]" value="last">
</form>
