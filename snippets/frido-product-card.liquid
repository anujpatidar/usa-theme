{% comment %}
  @param card_product {Product}
  @param show_swatches {Boolean}
  @param pdp_rec {Boolean} — PDP recommendation row styling (green sale badge)
  @param collection_seed {Number} — per-collection seed; varies default color + card link
{% endcomment %}
{%- if card_product != blank -%}
  {%- liquid
    assign card_url = card_product.url
    assign compare = card_product.compare_at_price
    assign price = card_product.price
    assign discount_pct = 0
    if compare != blank and compare > price
      assign discount_pct = compare | minus: price | times: 100.0 | divided_by: compare | round
    endif
    assign default_media = card_product.featured_media
    assign default_color_value = ''
    assign swatch_start_index = 0

    if collection_seed != blank
      assign coll_num = collection_seed | plus: 0
      assign prod_num = card_product.id | split: '/' | last | plus: 0
      assign swatch_start_index = prod_num | plus: coll_num | modulo: 97

      for option in card_product.options_with_values
        assign opt_down = option.name | downcase
        if opt_down == 'color' or opt_down == 'colour'
          assign color_count = option.values.size
          if color_count > 0
            assign pick_index = swatch_start_index | modulo: color_count
            for value in option.values
              if forloop.index0 == pick_index
                assign default_color_value = value
              endif
            endfor

            case option.position
              when 1
                assign picked_variant = card_product.variants | where: 'option1', default_color_value | first
              when 2
                assign picked_variant = card_product.variants | where: 'option2', default_color_value | first
              when 3
                assign picked_variant = card_product.variants | where: 'option3', default_color_value | first
            endcase

            if picked_variant != blank
              if picked_variant.featured_media != blank
                assign default_media = picked_variant.featured_media
              elsif picked_variant.image != blank
                assign default_media = picked_variant.image
              endif
              assign price = picked_variant.price
              assign compare = picked_variant.compare_at_price
              if compare != blank and compare > price
                assign discount_pct = compare | minus: price | times: 100.0 | divided_by: compare | round
              else
                assign discount_pct = 0
              endif
              assign variant_id_num = picked_variant.id | split: '/' | last
              assign card_url = card_product.url | append: '?variant=' | append: variant_id_num
            endif
          endif
          break
        endif
      endfor
    endif

    assign default_image_url = ''
    if default_media
      assign default_image_url = default_media | image_url: width: 800
    endif
    assign card_badge_secondary = card_product.metafields.custom.card_badge.value | default: ''
  -%}
  <article
    class="frido-pcard{% if pdp_rec %} frido-pcard--pdp-rec{% endif %}"
    data-frido-pcard
    data-product-id="{{ card_product.id }}"
    {% if default_image_url != blank %}data-default-image="{{ default_image_url }}"{% endif %}
  >
    {%- if discount_pct > 0 -%}
      <span class="frido-pcard__badge frido-pcard__badge--sale">{{ discount_pct }}% OFF</span>
    {%- endif -%}
    {%- if card_badge_secondary != blank -%}
      <span class="frido-pcard__badge frido-pcard__badge--secondary">{{ card_badge_secondary | escape }}</span>
    {%- endif -%}

    <a class="frido-pcard__link" href="{{ card_url }}">
      <div class="frido-pcard__img">
        {%- if default_media -%}
          {%- assign img_alt = default_media.alt | default: card_product.title | escape -%}
          {{
            default_media
            | image_url: width: 800
            | image_tag:
              loading: 'lazy',
              widths: '360,533,720,800',
              sizes: '(min-width: 990px) 22vw, 45vw',
              alt: img_alt,
              class: 'frido-pcard__img-el',
              data-frido-pcard-img: ''
          }}
        {%- else -%}
          {{ 'product-apparel-2' | placeholder_svg_tag: 'class="placeholder-svg"' }}
        {%- endif -%}
      </div>
    </a>

    <div class="frido-pcard__body">
      <a class="frido-pcard__body-link" href="{{ card_url }}">
        <div class="frido-pcard__cat">
          {%- if card_product.type != blank -%}
            {{ card_product.type | upcase }}
          {%- else -%}
            {{ card_product.vendor | upcase | default: 'SHOP' }}
          {%- endif -%}
        </div>
        <div class="frido-pcard__row">
          {% render 'frido-stars', rating: 5 %}
          {%- liquid
            assign rc = 128
            if card_product.metafields.reviews.rating_count.value != blank
              assign rc = card_product.metafields.reviews.rating_count.value
            endif
          -%}
          <span class="frido-stars__label">({{ rc }})</span>
        </div>
        <h3 class="frido-pcard__title">{{ card_product.title | escape }}</h3>
        <div class="frido-pcard__row frido-pcard__prices">
          <span class="frido-pcard__price">{{ price | money }}</span>
          {%- if compare != blank and compare > price -%}
            <span class="frido-pcard__compare">{{ compare | money }}</span>
          {%- endif -%}
        </div>
      </a>

      {%- if show_swatches -%}
        {%- for option in card_product.options_with_values -%}
          {%- assign opt_down = option.name | downcase -%}
          {%- if opt_down == 'color' or opt_down == 'colour' -%}
            <div class="frido-pcard__swatches" aria-label="{{ option.name | escape }}">
              {%- assign swatch_limit = 4 -%}
              {%- assign color_size = option.values.size -%}
              {%- assign extra = color_size | minus: swatch_limit -%}
              {%- if extra < 0 -%}
                {%- assign extra = 0 -%}
              {%- endif -%}
              {%- if collection_seed != blank and color_size > 0 -%}
                {%- assign pick_index = swatch_start_index | modulo: color_size -%}
              {%- else -%}
                {%- assign pick_index = 0 -%}
              {%- endif -%}
              {%- assign swatch_shown = 0 -%}
              {%- for value in option.values -%}
                {%- assign offset = forloop.index0 | minus: pick_index | plus: color_size | modulo: color_size -%}
                {%- unless offset < swatch_limit -%}
                  {%- continue -%}
                {%- endunless -%}
                {%- assign swatch_shown = swatch_shown | plus: 1 -%}
                {%- liquid
                  assign swatch_variant = nil
                  case option.position
                    when 1
                      assign swatch_variant = card_product.variants | where: 'option1', value | first
                    when 2
                      assign swatch_variant = card_product.variants | where: 'option2', value | first
                    when 3
                      assign swatch_variant = card_product.variants | where: 'option3', value | first
                  endcase
                  assign swatch_media = nil
                  if swatch_variant != nil
                    if swatch_variant.featured_media != nil
                      assign swatch_media = swatch_variant.featured_media
                    elsif swatch_variant.image != nil
                      assign swatch_media = swatch_variant.image
                    endif
                  endif
                  assign swatch_image_url = ''
                  if swatch_media
                    assign swatch_image_url = swatch_media | image_url: width: 800
                  endif
                -%}
                <button
                  type="button"
                  class="frido-pcard__swatch{% if swatch_image_url == blank %} frido-pcard__swatch--no-img{% endif %}{% if default_color_value != blank and value == default_color_value %} is-active{% endif %}"
                  {% if default_color_value != blank and value == default_color_value %}
                    data-frido-pcard-swatch-default
                  {% endif %}
                  title="{{ value | escape }}"
                  aria-label="{{ value | escape }}"
                  {% if swatch_image_url != blank %}
                    data-frido-pcard-swatch
                    data-image="{{ swatch_image_url }}"
                  {% endif %}
                >
                  {%- if swatch_media -%}
                    {{
                      swatch_media
                      | image_url: width: 80
                      | image_tag: loading: 'lazy', widths: '40,80', sizes: '32px', alt: ''
                    }}
                  {%- else -%}
                    <span class="frido-pcard__swatch-fallback">{{ value | escape | slice: 0, 1 }}</span>
                  {%- endif -%}
                </button>
              {%- endfor -%}
              {%- assign hidden_swatches = color_size | minus: swatch_shown -%}
              {%- if hidden_swatches > 0 -%}
                <span class="frido-pcard__swatch-more">+{{ hidden_swatches }}</span>
              {%- endif -%}
            </div>
            {%- break -%}
          {%- endif -%}
        {%- endfor -%}
      {%- endif -%}
    </div>
  </article>
{%- endif -%}
