{% comment %}
  Frido horizontal collection filters (Shopify Search & Discovery).
  Compatible with assets/facets.js
{% endcomment %}

{%- liquid
  assign sort_by = results.sort_by | default: results.default_sort_by
  if results.url
    assign results_url = results.url
  else
    assign terms = results.terms | escape
    assign results_url = '?q=' | append: terms | append: '&options%5Bprefix%5D=last&sort_by=' | append: sort_by
  endif

  assign current_sort_name = 'Manual'
  for option in results.sort_options
    if option.value == sort_by
      assign current_sort_name = option.name
      break
    endif
  endfor
-%}

<div class="frido-facets facets-container" data-frido-facets>
  <facet-filters-form class="facets">
    <form id="FacetFiltersForm" class="frido-facets__form facets__form">
      {%- if results.terms -%}
        <input type="hidden" name="q" value="{{ results.terms | escape }}">
        <input name="options[prefix]" type="hidden" value="last">
      {%- endif -%}

      <div class="frido-facets__top">
        <div class="frido-facets__top-left">
          <h2 class="frido-facets__title frido-facets__title--desktop">
            <span class="frido-facets__title-icon" aria-hidden="true">
              <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
  <path d="M3.33203 4.16667H8.33203M8.33203 4.16667C8.33203 5.08714 9.0782 5.83333 9.9987 5.83333C10.9192 5.83333 11.6654 5.08714 11.6654 4.16667M8.33203 4.16667C8.33203 3.24619 9.0782 2.5 9.9987 2.5C10.9192 2.5 11.6654 3.24619 11.6654 4.16667M11.6654 4.16667H16.6654M3.33203 10H13.332M13.332 10C13.332 10.9205 14.0782 11.6667 14.9987 11.6667C15.9192 11.6667 16.6654 10.9205 16.6654 10C16.6654 9.0795 15.9192 8.33333 14.9987 8.33333C14.0782 8.33333 13.332 9.0795 13.332 10ZM6.66536 15.8333H16.6654M6.66536 15.8333C6.66536 14.9128 5.91917 14.1667 4.9987 14.1667C4.07822 14.1667 3.33203 14.9128 3.33203 15.8333C3.33203 16.7538 4.07822 17.5 4.9987 17.5C5.91917 17.5 6.66536 16.7538 6.66536 15.8333Z" stroke="black" stroke-linecap="round"/>
</svg>

            </span>
            Filters
          </h2>
        </div>
        <p class="frido-facets__count" role="status">
          <span id="ProductCountDesktop">
            {%- if results.products_count == 1 -%}
              {{ results.products_count }} Item
            {%- else -%}
              {{ results.products_count }} Items
            {%- endif -%}
          </span>
        </p>
      </div>

      {%- liquid
        assign has_active_facets = false
        if current_tags.size > 0
          assign has_active_facets = true
        endif
        for filter in results.filters
          if filter.active_values.size > 0
            assign has_active_facets = true
            break
          endif
          if filter.type == 'price_range'
            assign min_check = filter.min_value.value
            assign max_check = filter.max_value.value
            if min_check != null or max_check != null
              assign has_active_facets = true
              break
            endif
          endif
        endfor
      -%}

      <div class="active-facets active-facets-desktop frido-facets__active{% unless has_active_facets %} frido-facets__active--empty{% endunless %}">
        {%- if collection != blank -%}
        {%- for tag in current_tags -%}
          {%- liquid
            assign tag_group = 'Condition'
            if tag == 'Shoes' or tag == 'Socks'
              assign tag_group = 'Category'
            elsif tag == 'Women' or tag == 'Men'
              assign tag_group = 'Gender'
            elsif tag == 'Walking' or tag == 'Work'
              assign tag_group = 'Activity'
            endif
          -%}
          {%- render 'frido-facet-tag-url', collection: collection, tag: tag, active: true -%}
          <facet-remove>
            <a href="{{ facet_tag_url }}" class="frido-facets__pill">
              <span>{{ tag_group | escape }}: {{ tag | escape }}</span>
              <span class="frido-facets__pill-x" aria-hidden="true">×</span>
            </a>
          </facet-remove>
        {%- endfor -%}
        {%- endif -%}
        {%- for filter in results.filters -%}
          {%- for value in filter.active_values -%}
            <facet-remove>
              <a href="{{ value.url_to_remove }}" class="frido-facets__pill">
                <span>{{ filter.label | escape }}: {{ value.label | escape }}</span>
                <span class="frido-facets__pill-x" aria-hidden="true">×</span>
                <span class="visually-hidden">{{ 'products.facets.clear_filter' | t }}</span>
              </a>
            </facet-remove>
          {%- endfor -%}
          {%- if filter.type == 'price_range' -%}
            {%- assign min = filter.min_value.value -%}
            {%- assign max = filter.max_value.value -%}
            {%- if min != null or max != null -%}
              <facet-remove>
                <a href="{{ filter.url_to_remove }}" class="frido-facets__pill">
                  <span>{{ min | default: 0 | money }} – {{ max | default: filter.range_max | money }}</span>
                  <span class="frido-facets__pill-x" aria-hidden="true">×</span>
                </a>
              </facet-remove>
            {%- endif -%}
          {%- endif -%}
        {%- endfor -%}
        {%- if has_active_facets -%}
          <facet-remove class="frido-facets__clear-wrap">
            <a href="{{ results_url }}" class="frido-facets__clear-all">{{ 'products.facets.clear_all' | t }}</a>
          </facet-remove>
        {%- endif -%}
      </div>

      <div class="frido-facets__toolbar frido-facets__toolbar--desktop" id="FacetsWrapperDesktop">
        {%- if enable_sorting -%}
          <details class="frido-facets__dropdown js-filter disclosure-has-popup facets__disclosure" id="Details-SortBy-{{ section.id }}">
            <summary class="frido-facets__summary facets__summary">
              <span class="frido-facets__summary-label">{{ current_sort_name | escape }}</span>
              <span class="frido-facets__chevron" aria-hidden="true"></span>
            </summary>
            <div class="facets__display frido-facets__panel" id="Facet-SortBy-{{ section.id }}">
              <fieldset class="facets-wrap facets__list list-unstyled">
                <legend class="visually-hidden">{{ 'products.facets.sort_by_label' | t }}</legend>
                <ul class="facets-layout facets-layout-list list-unstyled" role="list">
                  {%- for option in results.sort_options -%}
                    <li class="list-menu__item facets__item">
                      <label class="facets__label facet-checkbox{% if option.value == sort_by %} active{% endif %}">
                        <input
                          type="radio"
                          name="sort_by"
                          value="{{ option.value | escape }}"
                          {% if option.value == sort_by %}
                            checked
                          {% endif %}
                        >
                        <span class="facet-checkbox__text-label">{{ option.name | escape }}</span>
                      </label>
                    </li>
                  {%- endfor -%}
                </ul>
              </fieldset>
            </div>
          </details>
        {%- endif -%}

        {%- if collection != blank -%}
          {% render 'frido-facets-catalog', collection: collection, section: section %}
        {%- endif -%}

        {%- if enable_filtering -%}
          {%- for filter in results.filters -%}
            {%- liquid
              assign filter_label_down = filter.label | downcase
              if filter_label_down == 'category' or filter_label_down == 'gender' or filter_label_down == 'activity' or filter_label_down == 'condition'
                continue
              endif
              assign active_count = filter.active_values.size
              if filter.type == 'price_range'
                assign min = filter.min_value.value
                assign max = filter.max_value.value
                if min != null or max != null
                  assign active_count = 1
                endif
              endif
            -%}

            <details
              id="Details-{{ filter.param_name | escape }}-{{ section.id }}"
              class="frido-facets__dropdown js-filter disclosure-has-popup facets__disclosure{% if active_count > 0 %} frido-facets__dropdown--active{% endif %}"
              data-index="{{ forloop.index }}"
            >
              <summary class="frido-facets__summary facets__summary">
                <span class="frido-facets__summary-label">{{ filter.label | escape }}</span>
                {%- if active_count > 0 -%}
                  <span class="frido-facets__badge">{{ active_count }}</span>
                {%- endif -%}
                <span class="frido-facets__chevron" aria-hidden="true"></span>
              </summary>

              <div class="facets__display frido-facets__panel" id="Facet-{{ forloop.index }}-{{ section.id }}">
                {%- case filter.type -%}
                  {%- when 'boolean', 'list' -%}
                    <div class="facets__header frido-facets__panel-head">
                      <span class="facets__selected">
                        {{- 'products.facets.filters_selected' | t: count: filter.active_values.size -}}
                      </span>
                      <facet-remove>
                        <a href="{{ filter.url_to_remove }}" class="facets__reset link underlined-link">
                          {{ 'products.facets.reset' | t }}
                        </a>
                      </facet-remove>
                    </div>
                    <fieldset class="facets-wrap parent-wrap">
                      <legend class="visually-hidden">{{ filter.label | escape }}</legend>
                      <ul class="facets-layout facets-layout-list facets__list list-unstyled" role="list">
                        {%- for value in filter.values -%}
                          {%- liquid
                            assign input_id = 'Filter-' | append: filter.param_name | escape | append: '-' | append: forloop.index
                            assign is_disabled = false
                            if value.count == 0 and value.active == false
                              assign is_disabled = true
                            endif
                          -%}
                          <li class="list-menu__item facets__item">
                            <label for="{{ input_id }}" class="facets__label facet-checkbox{% if is_disabled %} disabled{% endif %}{% if value.active %} active{% endif %}">
                              <input
                                type="checkbox"
                                name="{{ value.param_name }}"
                                value="{{ value.value }}"
                                id="{{ input_id }}"
                                {% if value.active %}
                                  checked
                                {% endif %}
                                {% if is_disabled %}
                                  disabled
                                {% endif %}
                              >
                              <span class="facet-checkbox__text-label">{{ value.label | escape }}</span>
                              <span class="frido-facets__option-count">({{ value.count }})</span>
                            </label>
                          </li>
                        {%- endfor -%}
                      </ul>
                    </fieldset>
                  {%- when 'price_range' -%}
                    <div class="facets__header frido-facets__panel-head">
                      {%- assign max_price_amount = filter.range_max | money | strip_html | escape -%}
                      <span class="facets__selected">{{ 'products.facets.max_price' | t: price: max_price_amount }}</span>
                      <facet-remove>
                        <a href="{{ filter.url_to_remove }}" class="facets__reset link underlined-link">
                          {{ 'products.facets.reset' | t }}
                        </a>
                      </facet-remove>
                    </div>
                    <price-range class="facets__price">
                      {% render 'price-facet', filter: filter, id_prefix: 'Filter-', filter_type: 'horizontal' %}
                    </price-range>
                {%- endcase -%}
              </div>
            </details>
          {%- endfor -%}
        {%- endif -%}
      </div>

      <span id="ProductCount" class="visually-hidden">
        {%- if results.products_count == 1 -%}
          {{ results.products_count }} Item
        {%- else -%}
          {{ results.products_count }} Items
        {%- endif -%}
      </span>
    </form>
  </facet-filters-form>

  <div class="frido-facets__mobile-bar">
    {% render 'frido-facets-mobile',
      results: results,
      collection: collection,
      enable_filtering: enable_filtering,
      enable_sorting: enable_sorting,
      section: section,
      results_url: results_url,
      sort_by: sort_by
    %}
    <p class="frido-facets__count frido-facets__count--mobile" role="status">
      <span id="ProductCountMobile">
        {%- if results.products_count == 1 -%}
          {{ results.products_count }} Item
        {%- else -%}
          {{ results.products_count }} Items
        {%- endif -%}
      </span>
    </p>
  </div>
</div>
