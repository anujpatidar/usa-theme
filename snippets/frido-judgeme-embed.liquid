{% comment %}
  Judge.me Review Widget — official install code.
  @param product {Product}
{% endcomment %}
<!-- Start of Judge.me code -->
{%- liquid
  assign widget_html = product.metafields.judgeme.widget.value | default: product.metafields.judgeme.widget
  assign has_legacy_widget = false
  if widget_html != blank and widget_html.size > 20
    assign has_legacy_widget = true
  endif
-%}

{%- if has_legacy_widget -%}
  <div class="jdgm-legacy-widget-content" data-frido-judgeme-legacy>
    {{ widget_html }}
  </div>
{%- else -%}
  <div style="clear: both"></div>
  <div
    id="judgeme_product_reviews"
    class="jdgm-widget jdgm-review-widget"
    data-product-title="{{ product.title | escape }}"
    data-id="{{ product.id }}"
    data-product-id="{{ product.id }}"
    data-widget="review"
    data-auto-install="false"
    data-shop-reviews-count="{{ shop.metafields.judgeme.shop_reviews_count | default: 0 | escape }}"
    data-entry-point="review_widget.js"
    data-entry-key="review-widget/main.js"
  ></div>
  {%- assign judgeme_data = product.metafields.judgeme.review_widget_data.value | default: product.metafields.judgeme.review_widget_data -%}
  {%- if judgeme_data != blank -%}
    <script>
      window.jdgm = window.jdgm || {};
      jdgm.data = jdgm.data || {};
      jdgm.data.reviewWidget = jdgm.data.reviewWidget || {};
      jdgm.data.reviewWidget[{{ product.id }}] = {{ judgeme_data }};
    </script>
  {%- endif -%}
{%- endif -%}
<!-- End of Judge.me code -->
