{% comment %}
  @param image {Image} optional
  @param icon {String} foot | align | flex | sole
  @param size {Number} display size for raster (default 56)
  @param layout {String} circle (28) | item (24) | bar (22) | split (28) | collection (32)
{% endcomment %}
{%- liquid
  assign sz = size | default: 56
  assign layout = layout | default: 'circle'
  case layout
    when 'item'
      assign dim = 24
    when 'bar'
      assign dim = 22
    when 'split'
      assign dim = 28
    when 'collection'
      assign dim = 32
    else
      assign dim = 28
  endcase
  assign img_w = sz | times: 4
  if img_w < 120
    assign img_w = 120
  endif
  assign icon_alt = image.alt | default: '' | escape
  assign sizes_attr = sz | append: 'px'
-%}
{%- if image != blank -%}
  {{
    image
    | image_url: width: img_w
    | image_tag: loading: 'lazy', class: 'frido-icon-or-image__img', widths: '64,128,200', sizes: sizes_attr, alt: icon_alt
  }}
{%- elsif layout == 'collection' -%}
  {% case icon %}
    {% when 'flex' %}
      <svg width="{{ dim }}" height="{{ dim }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 18c2-8 4-12 6-14 2 2 3 5 4 8"/><path d="M10 8c1 2 2 4 2 6"/><path d="M14 6c-1 2-2 4-2 6"/></svg>
    {% when 'align' %}
      <svg width="{{ dim }}" height="{{ dim }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 16c2-6 4-9 6-11"/><path d="M10 14l2 4"/><path d="M14 8c2 2 3 5 4 8"/></svg>
    {% when 'sole' %}
      <svg width="{{ dim }}" height="{{ dim }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 14h14"/><path d="M7 14c1-3 3-5 5-5s4 2 5 5"/><path d="M9 14v2M15 14v2"/></svg>
    {% else %}
      <svg width="{{ dim }}" height="{{ dim }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><ellipse cx="12" cy="11" rx="5" ry="3"/><path d="M7 11h10"/><path d="M8 8h8M8 14h8"/></svg>
  {% endcase %}
{%- else -%}
  {% case icon %}
    {% when 'align' %}
      <svg width="{{ dim }}" height="{{ dim }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M4 12h16M8 6h8M6 18h12"/></svg>
    {% when 'flex' %}
      <svg width="{{ dim }}" height="{{ dim }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M7 4l-3 8h4l-2 8 10-11h-5l4-5H7z"/></svg>
    {% when 'sole' %}
      <svg width="{{ dim }}" height="{{ dim }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><ellipse cx="12" cy="14" rx="8" ry="5"/><path d="M6 12c2-3 10-3 12 0"/></svg>
    {% else %}
      <svg width="{{ dim }}" height="{{ dim }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M8 20c2-6 2-10 4-14 1 2 2 5 2 8h2c0-4 1-7 2-9 2 4 2 8 4 15"/></svg>
  {% endcase %}
{%- endif -%}
