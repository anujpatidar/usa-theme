{% comment %}
  Gender tabs, color swatches, size grid
  @param product {Product}
  @param section {Section}
{% endcomment %}
{%- liquid
  assign gender_option = nil
  assign gender_nav_mode = false
  assign active_gender_nav = ''
  assign men_product = product.metafields.custom.mens_product.value
  assign women_product = product.metafields.custom.womens_product.value

  if men_product == blank
    assign men_product = product.metafields.custom.men_product.value
  endif
  if women_product == blank
    assign women_product = product.metafields.custom.women_product.value
  endif

  assign pair_product = product.metafields.custom.gender_pair.value
  assign gender_metafield = product.metafields.custom.gender.value | default: product.metafields.custom.gender | downcase | strip

  if men_product == blank and women_product == blank and pair_product != blank
    if gender_metafield contains 'men' or gender_metafield == 'm' or gender_metafield == 'male'
      assign men_product = product
      assign women_product = pair_product
    else
      assign women_product = product
      assign men_product = pair_product
    endif
  endif

  if men_product != blank and women_product != blank
    assign gender_nav_mode = true
    if product.id == men_product.id
      assign active_gender_nav = 'men'
    elsif product.id == women_product.id
      assign active_gender_nav = 'women'
    elsif gender_metafield contains 'men' or gender_metafield == 'm' or gender_metafield == 'male'
      assign active_gender_nav = 'men'
    elsif gender_metafield contains 'women' or gender_metafield == 'w' or gender_metafield == 'female'
      assign active_gender_nav = 'women'
    elsif product.tags contains 'gender-men' or product.tags contains 'mens' or product.tags contains "men's"
      assign active_gender_nav = 'men'
    elsif product.tags contains 'gender-women' or product.tags contains 'womens' or product.tags contains "women's"
      assign active_gender_nav = 'women'
    else
      assign title_down = product.title | downcase
      if title_down contains "women's" or title_down contains 'women '
        assign active_gender_nav = 'women'
      elsif title_down contains "men's" or title_down contains 'men '
        assign active_gender_nav = 'men'
      endif
    endif
    assign men_url = men_product.url
    assign women_url = women_product.url
    assign men_handle = men_product.handle
    assign women_handle = women_product.handle
  endif

  assign color_option = nil
  assign size_option = nil
  assign gender_option = nil

  for option in product.options_with_values
    assign oname = option.name | downcase
    unless gender_nav_mode
      if gender_option == nil and oname contains 'gender'
        assign gender_option = option
      endif
    endunless
    if color_option == nil and oname contains 'color'
      assign color_option = option
    endif
    if size_option == nil and oname contains 'size'
      assign size_option = option
    endif
  endfor

  unless gender_nav_mode
    if gender_option == nil and product.options.size > 0
      assign first_name = product.options[0] | downcase
      if first_name contains 'gender' or first_name == 'men' or first_name == 'women'
        assign gender_option = product.options_with_values[0]
      endif
    endif
  endunless

  assign chart_enabled = section.settings.size_chart_enable
  if chart_enabled == nil
    assign chart_enabled = true
  endif

  assign show_gender_toggle = gender_nav_mode
  if show_gender_toggle == false and gender_option
    assign show_gender_toggle = true
  endif
-%}

{%- if gender_nav_mode -%}
  <script type="application/json" data-frido-gender-links>
    {
      "active": {{ active_gender_nav | json }},
      "men": {
        "id": {{ men_product.id | json }},
        "handle": {{ men_handle | json }},
        "url": {{ men_url | json }}
      },
      "women": {
        "id": {{ women_product.id | json }},
        "handle": {{ women_handle | json }},
        "url": {{ women_url | json }}
      }
    }
  </script>
{%- endif -%}

<div
  class="frido-pdp-variants"
  data-frido-variants
  {% if gender_nav_mode %}
    data-frido-gender-mode="link"
    data-frido-active-gender="{{ active_gender_nav | escape }}"
  {% elsif gender_option %}
    data-frido-gender-mode="variant"
    data-frido-gender-option="{{ gender_option.name | escape }}"
  {% endif %}
>
  {%- if show_gender_toggle -%}
    <div
      class="frido-pdp-gender"
      {% if gender_option and gender_nav_mode == false %}
        data-frido-option="{{ gender_option.name | escape }}"
      {% endif %}
    >
      <div class="frido-pdp-gender__tabs" role="tablist" aria-label="Gender">
        {%- if gender_nav_mode -%}
          <button
            type="button"
            class="frido-pdp-gender__tab{% if active_gender_nav == 'men' %} is-active{% endif %}"
            data-frido-gender-nav="men"
            data-frido-gender-url="{{ men_url | escape }}"
            data-frido-gender-handle="{{ men_handle | escape }}"
            role="tab"
            aria-selected="{% if active_gender_nav == 'men' %}true{% else %}false{% endif %}"
          >
            MEN
          </button>
          <button
            type="button"
            class="frido-pdp-gender__tab{% if active_gender_nav == 'women' %} is-active{% endif %}"
            data-frido-gender-nav="women"
            data-frido-gender-url="{{ women_url | escape }}"
            data-frido-gender-handle="{{ women_handle | escape }}"
            role="tab"
            aria-selected="{% if active_gender_nav == 'women' %}true{% else %}false{% endif %}"
          >
            WOMEN
          </button>
        {%- elsif gender_option -%}
          {%- for value in gender_option.values -%}
            {%- liquid
              assign value_slug = value | downcase
              assign tab_active = false
              if gender_option.selected_value == value
                assign tab_active = true
              endif
            -%}
            <button
              type="button"
              class="frido-pdp-gender__tab{% if tab_active %} is-active{% endif %}"
              data-frido-option-value="{{ value | escape }}"
              role="tab"
              aria-selected="{% if tab_active %}true{% else %}false{% endif %}"
            >
              {{ value | upcase | escape }}
            </button>
          {%- endfor -%}
        {%- endif -%}
      </div>
    </div>
  {%- endif -%}

  {%- if color_option -%}
    <div class="frido-pdp-colors" data-frido-option="{{ color_option.name | escape }}">
      <div class="frido-pdp-colors__swatches">
        {%- for value in color_option.values -%}
          {%- liquid
            assign swatch_img = nil
            for variant in product.variants
              if variant.options contains value and variant.featured_image
                assign swatch_img = variant.featured_image
                break
              endif
            endfor
          -%}
          <button
            type="button"
            class="frido-pdp-colors__swatch{% if color_option.selected_value == value %} is-active{% endif %}"
            data-frido-option-value="{{ value | escape }}"
            title="{{ value | escape }}"
          >
            {%- if swatch_img -%}
              {{ swatch_img | image_url: width: 120 | image_tag: loading: 'lazy', widths: '60,120', sizes: '56px', alt: value }}
            {%- else -%}
              <span class="frido-pdp-colors__label">{{ value | escape }}</span>
            {%- endif -%}
          </button>
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}

  {%- if size_option -%}
    <div class="frido-pdp-sizes" data-frido-option="{{ size_option.name | escape }}">
      <div class="frido-pdp-sizes__grid">
        {%- for value in size_option.values -%}
          <button
            type="button"
            class="frido-pdp-sizes__btn{% if size_option.selected_value == value %} is-active{% endif %}"
            data-frido-option-value="{{ value | escape }}"
          >
            {{ value | escape }}
          </button>
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}

  {%- if color_option or size_option -%}
    <div class="frido-pdp-selection">
      <p class="frido-pdp-selection__text" style="margin:0;" data-frido-selection-summary>
        {%- if color_option -%}Color: <strong data-frido-sel-color>{{ color_option.selected_value | escape }}</strong>{%- endif -%}
        {%- if size_option -%}{% if color_option %} {% endif %}Size: <strong data-frido-sel-size>{{ size_option.selected_value | escape }}</strong>{%- endif -%}
      </p>
      {%- if chart_enabled -%}
        <button
          type="button"
          class="frido-pdp-selection__chart"
          data-frido-size-chart-open="{{ section.id }}"
          aria-controls="frido-size-chart-{{ section.id }}"
          aria-expanded="false"
        >
          Size &amp; Fit Chart
        </button>
      {%- endif -%}
    </div>
  {%- endif -%}

  {%- comment -%} Hidden selects for options not shown as custom UI {%- endcomment -%}
  {%- for option in product.options_with_values -%}
    {%- unless option == gender_option or option == color_option or option == size_option -%}
      <label class="visually-hidden" for="Option-{{ section.id }}-{{ forloop.index }}">{{ option.name }}</label>
      <select id="Option-{{ section.id }}-{{ forloop.index }}" name="options[{{ option.name | escape }}]" data-frido-native-select>
        {%- for value in option.values -%}
          <option value="{{ value | escape }}"{% if option.selected_value == value %} selected{% endif %}>{{ value | escape }}</option>
        {%- endfor -%}
      </select>
    {%- endunless -%}
  {%- endfor -%}
</div>
