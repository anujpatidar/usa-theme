lProductVariantRr2 %}<!-- -->{% assign reploSortedSellingPlans = reploOriginalSPGRr2 %}<!-- -->{% assign reploSelectedSellingPlan = reploOriginalSSPRr2 %}<!-- -->{% assign reploSelectedSellingPlanPrice = reploOriginalSSPPriceRr2 %}<!-- -->{% assign reploCompareAtPriceDifferencePercentage = reploOriginalComparePricePercentRr2 %}<!-- -->{%- comment -%}replo-liquid-chunk-end{%- endcomment -%}</div><div data-rid="15cb938e-1b11-4375-8550-96ef8c347b32" class="r-17k7xck"><script>
/**
 * Check if a link is recognized as a video URL based on file extension.
 */
function isVideo(link) {
  const videoExtensions = ['mp4', 'webm', 'ogg', 'mov', 'avi'];
  const extension = link.split('?')[0].split('.').pop().toLowerCase();
  return videoExtensions.includes(extension);
}

/**
 * Loads either a video or an image into the specified element.
 * @param {HTMLElement} el    - The container element (e.g. a slide element).
 * @param {string} link       - The URL of the media.
 * @param {boolean} isSalt    - If true, treat as `data-salt` logic.
 */
function loadMedia(el, link, isSalt = false) {
  return new Promise((resolve, reject) => {
    // Find any existing <img> or <video> to replace. This prevents nuking
    // the entire container (which could break your carousel’s markup).
    let mediaEl = el.querySelector('img, video');

    const alreadyVideo = mediaEl && mediaEl.tagName.toLowerCase() === 'video';
    const willBeVideo = isVideo(link);

    // If there’s no existing media element, create one.
    if (!mediaEl) {
      mediaEl = document.createElement(willBeVideo ? 'video' : 'img');
      el.appendChild(mediaEl);
    } else {
      // If we have an <img> but need <video>, or vice versa, remove & recreate it
      if (alreadyVideo !== willBeVideo) {
        mediaEl.remove();
        mediaEl = document.createElement(willBeVideo ? 'video' : 'img');
        el.appendChild(mediaEl);
      }
    }

    // Now handle the logic for salt vs. namak + whether it’s a video or image:
    if (willBeVideo) {
      if (isSalt) {
        // data-salt + video => load fallback image
        const placeholderImg =
          'https://cdn.shopify.com/s/files/1/0918/8838/6366/files/Frame_1410086204.png?v=1739196548';
        mediaEl.src = placeholderImg; // mediaEl is an <img> in this scenario
        mediaEl.style.maxWidth = '100%';

        mediaEl.onload = () => {
          console.log('[loadMedia] Fallback image loaded (data-salt/video):', placeholderImg);
          resolve();
        };
        mediaEl.onerror = (err) => {
          console.error('[loadMedia] Error loading fallback image:', err);
          reject(err);
        };
      } else {
        // data-namak + video => actual video
        const posterUrl =
          'https://cdn.shopify.com/s/files/1/0553/0419/2034/files/1620-IntroVideo-SacralBelt-Thumbnail.webp?v=1739367935';
        mediaEl.src = link;
        mediaEl.poster = posterUrl;
        mediaEl.autoplay = true;
        mediaEl.muted = true;
        mediaEl.loop = true;
        mediaEl.playsInline = true;
        mediaEl.preload = 'auto';
        mediaEl.style.width = '100%';
        mediaEl.style.height = '100%';

        mediaEl.onloadeddata = () => {
          console.log('[loadMedia] Video loaded for data-namak:', link);
          resolve();
        };
        mediaEl.onerror = (err) => {
          console.error('[loadMedia] Error loading video:', err);
          reject(err);
        };
      }
    } else {
      // Not recognized as a video => load image
      mediaEl.src = link;
      mediaEl.style.maxWidth = '100%';

      mediaEl.onload = () => {
        console.log('[loadMedia] Image loaded:', link);
        resolve();
      };
      mediaEl.onerror = (err) => {
        console.error('[loadMedia] Error loading image:', err);
        reject(err);
      };
    }
  });
}

/**
 * Scans the document for [data-namak] and [data-salt] elements, loading media in each.
 */
async function initMediaElements() {
  console.log('[initMediaElements] Scanning for elements with data-namak or data-salt...');
  const dataNamakElements = document.querySelectorAll('[data-namak]');
  const dataSaltElements = document.querySelectorAll('[data-salt]');

  console.log(`[initMediaElements] Found ${dataNamakElements.length} data-namak elements.`);
  console.log(`[initMediaElements] Found ${dataSaltElements.length} data-salt elements.`);

  // Handle data-namak
  for (const el of dataNamakElements) {
    const link = el.getAttribute('data-namak');
    if (link) {
      console.log('[initMediaElements] Loading data-namak:', link);
      try {
        await loadMedia(el, link, false);
      } catch (error) {
        console.error('[initMediaElements] Failed to load data-namak media:', link, error);
      }
    }
  }

  // Handle data-salt
  for (const el of dataSaltElements) {
    const link = el.getAttribute('data-salt');
    if (link) {
      console.log('[initMediaElements] Loading data-salt:', link);
      try {
        await loadMedia(el, link, true);
      } catch (error) {
        console.error('[initMediaElements] Failed to load data-salt media:', link, error);
      }
    }
  }

  // If your carousel library needs a refresh/re-init, do it here:
  // window.myCarouselInstance && window.myCarouselInstance.refresh();
}

/**
 * Run once on window.load (instead of DOMContentLoaded), then
 * set up a MutationObserver to watch for new [data-namak]/[data-salt] elements.
 */
window.addEventListener('load', () => {
  console.log('[window.load] Starting initial media load...');
  initMediaElements().then(() => {
    console.log('[window.load] Initial media load finished.');
    // If your carousel library needs a re-init after changing slides, do it here.
    // For example: if (window.myCarouselInstance) window.myCarouselInstance.update();
  });

  // Real-time watch for changes in the DOM:
  const observer = new MutationObserver((mutations) => {
    let shouldReinit = false;

    mutations.forEach((mutation) => {
      // If an attribute changed
      if (mutation.type === 'attributes') {
        // Check if data-namak or data-salt changed
        if (
          mutation.attributeName === 'data-namak' ||
          mutation.attributeName === 'data-salt'
        ) {
          console.log('[MutationObserver] Attribute changed:', mutation.target);
          shouldReinit = true;
        }
      }

      // If new child elements were added
      if (mutation.type === 'childList' && mutation.addedNodes.length > 0) {
        mutation.addedNodes.forEach((node) => {
          if (node.nodeType === Node.ELEMENT_NODE) {
            if (
              node.hasAttribute &&
              (node.hasAttribute('data-namak') || node.hasAttribute('data-salt'))
            ) {
              console.log('[MutationObserver] New node with data-namak or data-salt added:', node);
              shouldReinit = true;
            }
          }
        });
      }
    });

    if (shouldReinit) {
      console.log('[MutationObserver] Changes detected. Re-initializing media elements...');
      initMediaElements();
    }
  });

  // Start observing the entire body (subtree)
  observer.observe(document.body, {
    childList: true,
    subtree: true,
    attributes: true
  });

  console.log('[window.load] MutationObserver has been set up.');
});
</script>
