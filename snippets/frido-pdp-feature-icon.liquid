{% comment %}
  @param icon {String} — feather, foot, blood, toe, gear, hands, shield, wide
  @param icon_image — file from metaobject (optional)
{% endcomment %}
<span class="frido-pdp-accordion__icon" aria-hidden="true">
  {%- if icon_image != blank -%}
    {{
      icon_image
      | image_url: width: 80
      | image_tag: loading: 'lazy', class: 'frido-pdp-accordion__icon-img', widths: '40,80', sizes: '24px', alt: ''
    }}
  {%- else -%}
    {%- case icon -%}
      {%- when 'hands' -%}
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M8 11V6.5a1.5 1.5 0 0 1 3 0V11m0-4.5a1.5 1.5 0 0 1 3 0V11m0-4.5a1.5 1.5 0 0 1 3 0V12a5 5 0 0 1-5 5h-1a4 4 0 0 1-4-4v-2"/></svg>
      {%- when 'wide' -%}
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><ellipse cx="12" cy="14" rx="7" ry="4"/><path d="M5 14c0-4 3.5-7 7-7s7 3 7 7"/></svg>
      {%- when 'foot' -%}
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 4c2 0 3 2 3 4v2h-6V8c0-2 1-4 3-4zm-5 8h10l-1 8H8l-1-8z"/></svg>
      {%- when 'blood' -%}
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 3l2.5 5.5L20 10l-4 4 .9 6L12 17l-4.9 3 .9-6-4-4 5.5-1.5L12 3z"/></svg>
      {%- when 'toe' -%}
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M6 14h12v4a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2v-4zm2-6h8v6H8V8z"/></svg>
      {%- when 'gear' -%}
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="3"/><path d="M12 2v2m0 16v2M4.93 4.93l1.41 1.41m11.32 11.32 1.41 1.41M2 12h2m16 0h2M4.93 19.07l1.41-1.41M18.36 5.64l1.41-1.41"/></svg>
      {%- when 'shield' -%}
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 3l7 3v5c0 4.5-3 8-7 10-4-2-7-5.5-7-10V6l7-3z"/><path d="M9 12l2 2 4-4"/></svg>
      {%- else -%}
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 20h16M6 20l2-12h8l2 12M9 8V4m6 4V4"/></svg>
    {%- endcase -%}
  {%- endif -%}
</span>
