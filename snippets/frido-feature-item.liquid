{% comment %}
  @param title, @param text, @param icon, @param icon_image optional
{% endcomment %}
<div class="frido-feature-item">
  <div class="frido-feature-item__icon" aria-hidden="true">
    {% render 'frido-icon-or-image', image: icon_image, icon: icon, size: 52, layout: 'item' %}
  </div>
  <div>
    <h3>{{ title | escape }}</h3>
    {% if text != blank %}
      <p>{{ text }}</p>
    {% endif %}
  </div>
</div>
