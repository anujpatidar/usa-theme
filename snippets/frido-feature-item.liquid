{% comment %}
  @param title, @param text, @param icon (foot|align|flex|sole)
{% endcomment %}
<div class="frido-feature-item">
  <div class="frido-feature-item__icon" aria-hidden="true">
    {% case icon %}
      {% when 'align' %}
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M4 12h16M8 6h8M6 18h12"/></svg>
      {% when 'flex' %}
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M7 4l-3 8h4l-2 8 10-11h-5l4-5H7z"/></svg>
      {% when 'sole' %}
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><ellipse cx="12" cy="14" rx="8" ry="5"/><path d="M6 12c2-3 10-3 12 0"/></svg>
      {% else %}
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M8 20c2-6 2-10 4-14 1 2 2 5 2 8h2c0-4 1-7 2-9 2 4 2 8 4 15"/></svg>
    {% endcase %}
  </div>
  <div>
    <h3>{{ title | escape }}</h3>
    {% if text != blank %}
      <p>{{ text }}</p>
    {% endif %}
  </div>
</div>
