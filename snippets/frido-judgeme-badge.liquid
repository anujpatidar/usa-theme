{% comment %}
  Judge.me Preview Badge — official PDP stars + review count.
  @param product {Product}
  @param class {String} optional extra class on wrapper
{% endcomment %}
{%- liquid
  assign jm_style = jm_style | default: ''
  assign badge_html = product.metafields.judgeme.badge.value | default: product.metafields.judgeme.badge
  assign extra_class = class | default: ''
-%}
<!-- Start of Judge.me code -->
<div
  style="{{ jm_style }}"
  class="jdgm-widget jdgm-preview-badge {{ extra_class }}"
  data-id="{{ product.id }}"
  data-auto-install="false"
>
  {{ badge_html }}
</div>
<!-- End of Judge.me code -->
