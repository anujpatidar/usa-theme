o-collapsible="true" data-state="closed"><div data-rid="a457bedc-2c40-47ce-90f9-55bb6e5f3b3a" aria-controls="replo-:R3kr2:" data-replo-repeated-index=".0.0.0.0.0.0.0" tabindex="0" role="button" class="r-kifj03"><div data-rid="4099a32f-b121-42da-9ab8-e62d5c7b1b45" data-replo-repeated-index=".0.0.0.0.0.0.0.0" class="r-g3lit5 alchemy-rte"><span style="width:100%"><p>What if my serial number is already registered?</p></span></div><div data-rid="af90c3d8-75d2-4311-8bcd-285caf3ecc12" data-replo-repeated-index=".0.0.0.0.0.0.0.0" class="r-1sh9kga"><span style="display:contents"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-chevron-down" style="fill: none;stroke: currentColor;width: var(--rsw, 100%);height: 100%" role="presentation"><polyline points="6 9 12 15 18 9"></polyline></svg></span></div></div><div hidden="" id="replo-:R3kr2:" aria-controls="replo-:R3kr2:"><div data-rid="3d5ab2a6-d600-403f-9aed-fd3c4bb2c056" data-replo-repeated-index=".0.0.0.0.0.0.0" class="r-1m2bpbs"><div data-rid="5feb316a-eb84-46dc-8f7a-55a4da7bcb93" data-replo-repeated-index=".0.0.0.0.0.0.0.0" class="r-ici9b2 alchemy-rte"><span style="width:100%"><p>If your serial number shows as already registered, this may indicate you've purchased a previously registered item or there might be a system error. Please contact our support team via the help chat or at <a href="mailto:support@myfrido.com">support@myfrido.com</a> with your proof of purchase, and we'll help verify ownership and transfer the warranty to your account.</p></span></div></div></div></div><div data-rid="b25b1688-562c-4b47-8077-5325849c058f" data-replo-repeated-index=".0.0.0.0.0.0" class="r-98x24z" data-replo-collapsible="true" data-state="closed"><div data-rid="dfb96190-89ae-4f63-a01b-9d16d57feac8" aria-controls="replo-:R4kr2:" data-replo-repeated-index=".0.0.0.0.0.0.0" tabindex="0" r