{% comment %}
  Frido star rating (global)
  @param rating {Number} 1-5 filled stars (default 5)
  @param label {String} optional text after stars
{% endcomment %}
{%- liquid
  assign r = rating | default: 5
  assign r = r | at_most: 5 | at_least: 0
-%}
<span class="frido-stars" role="img" aria-label="{{ r }} out of 5 stars">
  {%- for i in (1..5) -%}
    <svg width="14" height="14" viewBox="0 0 24 24" fill="{% if i <= r %}currentColor{% else %}none{% endif %}" stroke="currentColor" stroke-width="1.4" aria-hidden="true">
      <path d="M12 2.5l2.9 6.1 6.6.6-5 4.5 1.5 6.5L12 17.8 5.9 20.2l1.5-6.5-5-4.5 6.6-.6L12 2.5z"/>
    </svg>
  {%- endfor -%}
  {%- if label != blank -%}
    <span class="frido-stars__label">{{ label }}</span>
  {%- endif -%}
</span>
