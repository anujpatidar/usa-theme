{% comment %}
  Size Guidelines tab content — @param section {section}
{% endcomment %}

<div class="frido-scg__content">
  <h2>How to Measure Your Feet for the Right Fit</h2>
  <p>
    A good fit ensures comfort and durability. Here's how to measure accurately with our
    <strong>shoe size guide</strong>:
  </p>
  <ol class="frido-scg__steps">
    <li>
      <strong>Measure the Length:</strong> Place a piece of paper against a wall and stand with your heel
      touching it. Mark the end of your longest toe and measure the distance from the wall.
    </li>
    <li>
      <strong>Measure the Width:</strong> Find the widest part of your foot and measure across.
    </li>
    <li>
      <strong>Measure Both Feet:</strong> It's common for one foot to be slightly larger, so go with the
      larger size.
    </li>
    <li>
      <strong>Check the Size Guide:</strong> Use our <strong>shoe size guide</strong> to match your
      measurements with the closest fit. If between sizes, we suggest sizing up for extra comfort,
      especially if you wear socks.
    </li>
  </ol>
  <p>
    Following these steps ensures the best fit and makes your barefoot shoe experience as comfortable as
    possible.
  </p>

  <h2>Tips for Finding Your Perfect Fit</h2>
  <ul class="frido-scg__bullets">
    <li>
      <strong>Consider Sock Thickness:</strong> If you typically wear thicker socks, you might want to size
      up slightly to accommodate.
    </li>
    <li>
      <strong>Foot Swelling:</strong> Feet can swell throughout the day, so it's best to measure your feet
      in the afternoon or evening for a more accurate fit.
    </li>
    <li>
      <strong>Check for Width:</strong> If you have wider feet, look for shoes that offer wide sizes or
      additional room in the toe box.
    </li>
    <li>
      If your shoe size falls between two sizes, we recommend choosing the larger size. For instance, if a
      size 7 fits you well in some brands, but a size 7.5 fits better in others, we suggest ordering size
      7.5.
    </li>
  </ul>

  <h2>Click the Shoe Name to View the Size Chart</h2>
  <div class="frido-scg__product-links">
    {%- assign has_product_links = false -%}
    {%- for block in section.blocks -%}
      {%- if block.type == 'product_link' and block.settings.product != blank -%}
        {%- assign has_product_links = true -%}
        {%- liquid
          assign link_product = block.settings.product
          assign chart_product = block.settings.size_chart_product | default: link_product
          assign link_href = block.settings.url
          if link_href == blank
            assign link_href = '#frido-scg-chart-' | append: link_product.handle
          endif
        -%}
        <a
          class="frido-scg__product-link"
          href="{{ link_href }}"
          {{ block.shopify_attributes }}
        >
          {{ block.settings.label | default: link_product.title | escape }}
        </a>
      {%- endif -%}
    {%- endfor -%}
    {%- unless has_product_links -%}
      {%- for product in collections.all.products limit: 24 -%}
        <a class="frido-scg__product-link" href="#frido-scg-chart-{{ product.handle }}">
          {{- product.title | escape }} Sizes
        </a>
      {%- endfor -%}
    {%- endunless -%}
  </div>

  {%- if section.settings.size_table_html != blank -%}
    <div class="frido-scg__table-wrap rte">
      {{ section.settings.size_table_html }}
    </div>
  {%- endif -%}

  <div class="frido-scg__product-charts">
    {%- if has_product_links -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'product_link' and block.settings.product != blank -%}
          {%- liquid
            assign link_product = block.settings.product
            assign chart_product = block.settings.size_chart_product | default: link_product
            assign chart_gender = 'men'
            assign chart_handle = chart_product.handle | downcase
            case chart_handle
              when 'frido-active-casual-sneakers-womens', 'frido-active-walking-shoes-womens', 'frido-womens-cloud-comfort-shoes-lace-ups'
                assign chart_gender = 'women'
              when 'frido-kids-cloud-comfort-shoes-lace-ups'
                assign chart_gender = 'kids'
            endcase
            if chart_gender == 'men' and chart_handle contains 'women'
              assign chart_gender = 'women'
            endif
            if chart_gender == 'women'
              assign chart_subtitle = "Women's Size Chart"
            elsif chart_gender == 'kids'
              assign chart_subtitle = "Kids Size Chart"
            else
              assign chart_subtitle = "Men's Size Chart"
            endif
          -%}
          <section
            id="frido-scg-chart-{{ link_product.handle }}"
            class="frido-scg__product-chart"
            {{ block.shopify_attributes }}
          >
            <h3 class="frido-scg__product-chart-title">{{ link_product.title | escape }}</h3>
            <p class="frido-scg__product-chart-sub">{{ chart_subtitle | escape }}</p>
            <div class="frido-scg__table-wrap">
              {% render 'frido-size-chart-table',
                product: chart_product,
                chart_gender: chart_gender,
                table_class: 'frido-scg__table'
              %}
            </div>
          </section>
        {%- endif -%}
      {%- endfor -%}
    {%- else -%}
      {%- for product in collections.all.products limit: 24 -%}
        <section id="frido-scg-chart-{{ product.handle }}" class="frido-scg__product-chart">
          <h3 class="frido-scg__product-chart-title">{{ product.title | escape }}</h3>
          <div class="frido-scg__table-wrap">
            {% render 'frido-size-chart-table', product: product, table_class: 'frido-scg__table' %}
          </div>
        </section>
      {%- endfor -%}
    {%- endif -%}
  </div>
</div>
