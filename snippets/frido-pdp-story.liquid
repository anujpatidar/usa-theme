{% comment %}
  PDP story — text + image/video with alignment overlay (HIKE-style).
  Per product (optional): custom.story_heading, custom.story_body, custom.story_image, custom.story_video.
{% endcomment %}
{%- liquid
  assign story_heading = section.settings.story_heading
  assign story_body = section.settings.story_body
  assign story_image = section.settings.story_image
  assign story_video = section.settings.story_video
  assign story_show_overlay = section.settings.story_show_overlay
  assign story_callout_title = section.settings.story_callout_title
  assign story_callout_text = section.settings.story_callout_text
  assign story_line_position = section.settings.story_line_position | default: 54

  if product.metafields.custom.story_heading != blank
    assign story_heading = product.metafields.custom.story_heading.value | default: product.metafields.custom.story_heading
  endif
  if product.metafields.custom.story_body != blank
    assign story_body = product.metafields.custom.story_body.value | default: product.metafields.custom.story_body
  endif
  if product.metafields.custom.story_image != blank
    assign story_image = product.metafields.custom.story_image.value | default: product.metafields.custom.story_image
  endif
  if product.metafields.custom.story_video != blank
    assign story_video = product.metafields.custom.story_video.value | default: product.metafields.custom.story_video
  endif

  assign story_has_media = false
  if story_video != blank or story_image != blank
    assign story_has_media = true
  endif
-%}

{%- if story_heading != blank or story_body != blank or story_has_media -%}
  <section
    class="frido-pdp-story"
    aria-labelledby="FridoPdpStory-{{ section.id }}"
    style="--frido-story-line-x: {{ story_line_position }}%;"
  >
    <div class="frido-pdp-story__inner">
      <div class="frido-pdp-story__text">
        {%- if story_heading != blank -%}
          <h2 id="FridoPdpStory-{{ section.id }}" class="frido-pdp-story__heading">
            {{ story_heading | escape }}
          </h2>
        {%- endif -%}
        {%- if story_body != blank -%}
          <div class="frido-pdp-story__body rte">{{ story_body }}</div>
        {%- endif -%}
      </div>

      {%- if story_has_media -%}
        <div class="frido-pdp-story__media">
          <div class="frido-pdp-story__media-frame">
            {%- if story_video != blank -%}
              {{
                story_video
                | video_tag:
                  image_size: '1200x',
                  autoplay: true,
                  loop: true,
                  muted: true,
                  playsinline: true,
                  controls: false,
                  class: 'frido-pdp-story__video',
                  preload: 'metadata'
              }}
            {%- elsif story_image != blank -%}
              {{
                story_image
                | image_url: width: 1200
                | image_tag:
                  loading: 'lazy',
                  class: 'frido-pdp-story__img',
                  widths: '400,600,800,1000,1200',
                  sizes: '(min-width: 990px) 42vw, 100vw',
                  alt: story_heading
              }}
            {%- endif -%}

            {%- if story_show_overlay -%}
              <div class="frido-pdp-story__overlay" aria-hidden="true">
                <span class="frido-pdp-story__align-line"></span>
                <span class="frido-pdp-story__align-node frido-pdp-story__align-node--hip"></span>
                <span class="frido-pdp-story__align-node frido-pdp-story__align-node--knee"></span>
                <span class="frido-pdp-story__align-node frido-pdp-story__align-node--ankle"></span>
                {%- if story_callout_title != blank or story_callout_text != blank -%}
                  <div class="frido-pdp-story__callout">
                    {%- if story_callout_title != blank -%}
                      <p class="frido-pdp-story__callout-title">{{ story_callout_title | escape }}</p>
                    {%- endif -%}
                    {%- if story_callout_text != blank -%}
                      <p class="frido-pdp-story__callout-text">{{ story_callout_text | escape | newline_to_br }}</p>
                    {%- endif -%}
                  </div>
                {%- endif -%}
              </div>
            {%- endif -%}
          </div>
        </div>
      {%- endif -%}
    </div>
  </section>
{%- endif -%}
