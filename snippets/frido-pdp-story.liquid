{% comment %}
  PDP story — per-product metafield custom.pdp_story → PDP Story metaobject.
  Reusable via section: sections/frido-pdp-story.liquid
{% endcomment %}
{%- liquid
  assign story = product.metafields.custom.pdp_story.value
  assign story_heading = ''
  assign story_body_mf = null
  assign story_media = null

  if story != blank
    assign story_heading = story.heading.value | default: ''
    assign story_body_mf = story.body
    assign story_media = story.media.value
  endif
-%}

{% render 'frido-pdp-story-layout',
  heading: story_heading,
  body_metafield: story_body_mf,
  media: story_media,
  section_id: section.id
%}
