{% comment %}
  Sticky bar variant dropdowns — all product options.
  @param product {Product}
  @param section {Section}
{% endcomment %}
{%- for option in product.options_with_values -%}
  <div class="frido-pdp-sticky__field">
    <label class="visually-hidden" for="StickyOption-{{ section.id }}-{{ forloop.index }}">{{ option.name }}</label>
    <div class="frido-pdp-sticky__select-wrap">
      <select
        id="StickyOption-{{ section.id }}-{{ forloop.index }}"
        class="frido-pdp-sticky__select"
        data-frido-sticky-select="{{ option.name | escape }}"
        aria-label="{{ option.name | escape }}"
      >
        {%- for value in option.values -%}
          <option value="{{ value | escape }}"{% if option.selected_value == value %} selected{% endif %}>
            {{ value | escape }}
          </option>
        {%- endfor -%}
      </select>
      <span class="frido-pdp-sticky__select-chev" aria-hidden="true">
        <svg width="10" height="12" viewBox="0 0 10 12" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M2 4L5 1L8 4" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
          <path d="M2 8L5 11L8 8" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </span>
    </div>
  </div>
{%- endfor -%}
