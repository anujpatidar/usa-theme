{% comment %}
  PDP gallery — desktop: 1 hero + up to 6 grid tiles (7 total). Mobile: carousel.
  Populated per color in frido-product.js from product JSON + media alt tags.
  @param product {Product}
  @param section_id {String}
{% endcomment %}
{%- liquid
  assign gallery_alt = product.title | escape
  if product.selected_or_first_available_variant.featured_media
    assign hero_media = product.selected_or_first_available_variant.featured_media
  elsif product.media.size > 0
    assign hero_media = product.media.first
  endif
-%}

<div class="frido-pdp-gallery" data-frido-gallery>
  <div class="frido-pdp-gallery__desktop" data-frido-gallery-desktop>
    <div class="frido-pdp-gallery__hero" data-frido-gallery-hero>
      {%- if hero_media -%}
        {{
          hero_media
          | image_url: width: 1400
          | image_tag:
            loading: 'eager',
            class: 'frido-pdp-gallery__img',
            widths: '600,900,1200,1400',
            sizes: '(min-width: 990px) 50vw, 100vw',
            alt: hero_media.alt | default: gallery_alt,
            data-frido-gallery-img: ''
        }}
      {%- else -%}
        {{ 'product-apparel-2' | placeholder_svg_tag: 'frido-pdp-gallery__img placeholder-svg' }}
      {%- endif -%}
    </div>
    <div class="frido-pdp-gallery__pair" data-frido-gallery-pair></div>
  </div>

  <div class="frido-pdp-gallery__mobile" data-frido-gallery-mobile>
    <div class="frido-pdp-gallery__track" data-frido-gallery-track></div>
    <div class="frido-pdp-gallery__dots" data-frido-gallery-dots hidden></div>
  </div>
</div>
